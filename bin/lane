#!/usr/bin/env python3
"""lane: run one task as a detached `omp -p` session in its own worktree.

A lane lives in <seat>/state/lanes/<id>/ (lane.json, brief.md, final.md). Each run's stream,
stderr, exit code, process snapshot and runner/agent pids sit in <seat>/state/run/lanes/<id>/run-<n>.*.
"""

import argparse
import contextlib
import datetime as dt
import fcntl
import itertools
import json
import os
import re
import signal
import socket
import subprocess
import sys
import time
import uuid
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from pr_verdict import render_verdict, verdict_fact

ENGINE = Path(os.environ.get("TSTACK_HOME") or Path(__file__).resolve().parents[1])
WORKTREES = Path(os.environ.get("TSTACK_WORKTREES") or Path.home() / "worktrees")
PASS_ENV = ("PATH", "HOME", "USER", "SHELL", "LANG", "LC_ALL", "TERM", "TMPDIR", "SSH_AUTH_SOCK", "EASL_SOCKET",
            "TSTACK_HOME", "TSTACK_INSTANCE", "TSTACK_WORKTREES", "TSTACK_MACHINE")
# Terminals easld spawns from a system unit lack the user bus that systemctl --user needs.
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
BUS = {**os.environ, "XDG_RUNTIME_DIR": RUNTIME,
       "DBUS_SESSION_BUS_ADDRESS": os.environ.get("DBUS_SESSION_BUS_ADDRESS") or f"unix:path={RUNTIME}/bus"}
# The run goes through sh so its exit code outlives the detached process that ran it. The TERM trap keeps the
# shell waiting until omp has exited, and the exit file appears whole, by rename.
RUNNER = ('trap : TERM; python="$1"; writer="$2"; backend="$3"; marker="$4"; shift 4; '
          '(trap : TERM; "$python" "$writer" _agent "$0.agent" "$marker" "$@" '
          '2> "$0.err"; echo $? > "$0.exit.tmp") | "$python" "$writer" _stream > "$0.jsonl"; '
          'if [ "$backend" = nohup ]; then "$python" "$writer" _processes "$0.processes" nohup "$marker"; fi; '
          'mv -f "$0.exit.tmp" "$0.exit"')


class Fail(Exception):
    pass


def now() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def exit_reason(run_entry: dict) -> str:
    outcome = run_entry.get("systemd") or {}
    result = outcome.get("result")
    if not result or result == "success":
        return ""
    peak, cap = outcome.get("memory_peak"), outcome.get("memory_max")
    details = []
    if peak is not None:
        details.append(f"peak {memory_size(peak, peak=True)}")
    if cap is not None:
        details.append(f"of {memory_size(cap)} cap" if details else f"{memory_size(cap)} cap")
    return result + (f" ({' '.join(details)})" if details else "")


def memory_size(value: int, peak: bool = False) -> str:
    size = float(value)
    for unit in ("B", "K", "M", "G", "T", "P", "E"):
        if size < 1024 or unit == "E":
            return (f"{size:.1f}" if peak else f"{size:g}") + unit
        size /= 1024


def exit_code(run_entry: dict) -> str:
    code = "-" if run_entry.get("exit") is None else str(run_entry["exit"])
    reason = exit_reason(run_entry)
    return code + (f"; {reason}" if reason else "")


def unit_outcome(unit: str) -> dict:
    outcome = {}
    try:
        result = subprocess.run(["systemctl", "--user", "show", "-p", "LoadState", "-p", "Result",
                                 "-p", "MemoryPeak", "-p", "MemoryMax", unit],
                                env=BUS, capture_output=True, text=True, timeout=2)
        if result.returncode == 0:
            properties = dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)
            if properties.get("LoadState") != "loaded":
                return outcome
            if properties.get("Result"):
                outcome["result"] = properties["Result"]
            for prop, key in (("MemoryPeak", "memory_peak"), ("MemoryMax", "memory_max")):
                value = properties.get(prop, "")
                if value.isdigit() and int(value) < 2**64 - 1:
                    outcome[key] = int(value)
    except (OSError, subprocess.TimeoutExpired):
        pass
    return outcome


def capture_result(path: Path, unit: str) -> None:
    outcome = {**unit_outcome(unit), "result": os.environ.get("SERVICE_RESULT", "")}
    temporary = path.with_suffix(".result.tmp")
    temporary.write_text(json.dumps(outcome) + "\n")
    temporary.replace(path)


def capture_processes(path: Path, backend: str, marker: str) -> None:
    excluded = {os.getpid()}
    agent = path.with_suffix(".agent")
    if agent.exists():
        excluded.add(int(agent.read_text()))
    members, marked = set(), set()
    if backend == "nohup":
        result = subprocess.run(["ps", "-wwE", "-U", str(os.getuid()), "-o", "pid=,command="],
                                capture_output=True, text=True)
        if result.returncode:
            raise Fail(result.stderr.strip() or f"ps exited {result.returncode}")
        match = re.compile(r"(?:^|\s)TSTACK_LANE_RUN=" + re.escape(marker) + r"(?:\s|$)")
        for line in result.stdout.splitlines():
            pid, _, environment = line.strip().partition(" ")
            if pid.isdigit() and int(pid) not in excluded and match.search(environment):
                marked.add(int(pid))
    else:
        group = next(line.split(":", 2)[2] for line in Path("/proc/self/cgroup").read_text().splitlines()
                     if line.startswith("0::"))
        root = Path("/sys/fs/cgroup") / group.lstrip("/")
        for procs in root.glob("**/cgroup.procs"):
            try:
                members.update(int(pid) for pid in procs.read_text().split())
            except FileNotFoundError:
                continue
        runner = path.with_suffix(".pid")
        main = os.environ.get("MAINPID") or (runner.read_text().strip() if runner.exists() else "")
        if main.isdigit():
            excluded.add(int(main))
            for pid in members:
                try:
                    parent = (Path("/proc") / str(pid) / "stat").read_text().rpartition(")")[2].split()[1]
                    if parent == main:
                        excluded.add(pid)
                except (FileNotFoundError, ProcessLookupError, PermissionError):
                    continue
        token = f"TSTACK_LANE_RUN={marker}".encode()
        for proc in Path("/proc").iterdir():
            if not proc.name.isdigit() or int(proc.name) in excluded:
                continue
            try:
                if proc.stat().st_uid == os.getuid() and token in (proc / "environ").read_bytes().split(b"\0"):
                    marked.add(int(proc.name))
            except (FileNotFoundError, ProcessLookupError, PermissionError):
                continue
    candidates = (members | marked) - excluded
    snapshot = {"reason": "exited", "killed": [], "running": []}
    result = os.environ.get("SERVICE_RESULT", "")
    if result and result != "success":
        snapshot["reason"] = result
    elif path.with_suffix(".stop").exists() or not any(path.with_suffix(ext).exists() for ext in (".exit", ".exit.tmp")):
        snapshot["reason"] = "stopped"
    if candidates:
        result = subprocess.run(["ps", "-ww", "-p", ",".join(map(str, sorted(candidates))),
                                 "-o", "pid=,stat=,command="], capture_output=True, text=True)
        if result.returncode and result.stderr.strip():
            raise Fail(result.stderr.strip())
        for line in result.stdout.splitlines():
            fields = line.strip().split(None, 2)
            if len(fields) != 3:
                continue
            pid, state, command = fields
            pid = int(pid)
            if pid not in candidates or state.startswith("Z") or re.search(r"(?:^|\s)__omp_worker", command):
                continue
            key = "killed" if pid in members else "running"
            command = " ".join(command.split())
            snapshot[key].append({"pid": pid, "command": command if len(command) <= 120 else command[:117] + "..."})
    temporary = path.with_suffix(".processes.tmp")
    temporary.write_text(json.dumps(snapshot) + "\n")
    temporary.replace(path)


def process_lines(runs: list) -> list:
    lines = []
    for entry in runs:
        snapshot = entry.get("processes") or {}
        count = len(snapshot.get("killed") or []) + len(snapshot.get("running") or [])
        if count:
            details = []
            if snapshot.get("reason") != "exited":
                details.append(snapshot["reason"])
            for key, label in (("killed", "killed by unit stop"), ("running", "still running after the run")):
                if snapshot.get(key):
                    if key == "running" and entry.get("backend") == "nohup":
                        label = "still running (partial: macOS hides environments of system binaries)"
                    commands = "; ".join(f"{p['pid']} {p['command']}" for p in snapshot[key])
                    details.append(f"{label}: {commands}")
            noun = "process" if count == 1 else "processes"
            lines.append(f"run {entry['run']} ended with {count} {noun}: {': '.join(details)}")
    return lines


def run(argv, cwd=None, env=None, check=True) -> str:
    try:
        result = subprocess.run(argv, cwd=cwd, env=env, capture_output=True, text=True)
    except FileNotFoundError:
        raise Fail(f"{argv[0]}: not found")
    if check and result.returncode:
        raise Fail(f"{' '.join(map(str, argv[:4]))}: {(result.stderr or result.stdout).strip()}")
    return result.stdout if "\0" in result.stdout else result.stdout.strip()


def git(repo, *args, check=True) -> str:
    return run(["git", "-C", str(repo), *args], check=check)


def filter_stream(source, target):
    for line in source:
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if not isinstance(event, dict):
            continue
        kind = event.get("type")
        if kind == "session":
            projected = {"type": kind, "id": event.get("id")}
        elif kind == "tool_execution_start":
            projected = {"type": kind, "toolName": event.get("toolName"),
                         "intent": event.get("intent") or json.dumps(event.get("args"))[:200]}
        elif (text := assistant_text(event)) is not None:
            total = ((event["message"].get("usage") or {}).get("cost") or {}).get("total") or 0
            projected = {"type": kind, "message": {"role": "assistant",
                         "content": [{"type": "text", "text": text}],
                         "usage": {"cost": {"total": total}}}}
        else:
            continue
        target.write(json.dumps(projected, separators=(",", ":")) + "\n")
        target.flush()


def events(path: Path):
    if path.exists():
        with path.open(errors="replace") as source:
            for line in source:
                try:
                    event = json.loads(line)
                    if isinstance(event, dict):
                        yield event
                except ValueError:
                    continue


def assistant_text(event: dict):
    """The text of an assistant message_end event, '' for one without text, None for any other event."""
    message = event.get("message") or {}
    if event.get("type") != "message_end" or message.get("role") != "assistant":
        return None
    return "\n".join(c.get("text", "") for c in message.get("content") or [] if c.get("type") == "text").strip()


def process_identity(pid: str, backend: str | None) -> tuple[str, str] | None:
    if sys.platform != "darwin" and backend != "nohup":
        try:
            fields = (Path("/proc") / pid / "stat").read_text().rpartition(")")[2].split()
            boot = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
            return (fields[0], f"linux:{boot}:{fields[19]}") if fields[19].isdigit() else None
        except (OSError, IndexError):
            return None
    try:
        result = subprocess.run(["ps", "-ww", "-o", "stat=,lstart=", "-p", pid],
                                env={**os.environ, "LC_ALL": "C", "TZ": "UTC"},
                                capture_output=True, text=True, timeout=2)
    except (OSError, subprocess.TimeoutExpired):
        return None
    fields = result.stdout.split()
    if result.returncode or len(fields) != 6:
        return None
    return fields[0], " ".join(fields[1:])


class Lane:
    def __init__(self, seat: Path, lane_id: str):
        self.seat, self.id, self.unit = seat, lane_id, f"tstack-lane-{lane_id}"
        self.dir, self.run_dir = seat / "state" / "lanes" / lane_id, seat / "state" / "run" / "lanes" / lane_id

    def file(self, number: int, ext: str) -> Path:
        return self.run_dir / f"run-{number}.{ext}"

    def load(self) -> dict:
        try:
            return json.loads((self.dir / "lane.json").read_text())
        except FileNotFoundError:
            raise Fail(f"no lane {self.id} in {self.seat}")

    def save(self, record: dict) -> None:
        record["updated"] = now()
        (self.dir / ".lane.json.tmp").write_text(json.dumps(record, indent=1) + "\n")
        os.replace(self.dir / ".lane.json.tmp", self.dir / "lane.json")

    @contextlib.contextmanager
    def locked(self):
        self.run_dir.mkdir(parents=True, exist_ok=True)
        with open(self.run_dir / "lock", "a") as handle:
            fcntl.flock(handle, fcntl.LOCK_EX)
            yield

    def update(self, **fields) -> None:
        with self.locked():
            self.save({**self.load(), **fields})

    def pid(self, number: int) -> str:
        path = self.file(number, "pid")
        return path.read_text().strip() if path.exists() else ""

    def alive(self, number: int) -> bool:
        entry = self.load()["runs"][number - 1]
        if sys.platform != "darwin" and entry.get("backend") != "nohup":
            state = run(["systemctl", "--user", "show", "-p", "ActiveState", "--value", self.unit],
                        env=BUS, check=False)
            if state in {"active", "activating", "deactivating"}:
                return True
        if self.file(number, "exit").exists():
            return False
        pid = self.pid(number)
        if not pid.isdigit() or int(pid) <= 0:
            return False
        try:
            os.kill(int(pid), 0)
        except ProcessLookupError:
            return False
        except PermissionError:
            pass
        identity = process_identity(pid, entry.get("backend"))
        if identity is None:
            return True
        state, start = identity
        return not state.startswith("Z") and (not entry.get("pid_start") or entry["pid_start"] == start)

    def read_outcomes(self, record: dict) -> bool:
        changed = False
        for entry in record.get("runs") or []:
            for ext, key in (("result", "systemd"), ("processes", "processes")):
                path = self.file(entry["run"], ext)
                if path.exists():
                    outcome = json.loads(path.read_text())
                    if entry.get(key) != outcome:
                        entry[key] = outcome
                        changed = True
        return changed

    def start_process(self, command: list, record: dict, env: dict) -> str:
        if sys.platform == "darwin":
            process = subprocess.Popen(["/usr/bin/nohup", *command], cwd=record["worktree"], env=env,
                                       start_new_session=True, stdin=subprocess.DEVNULL,
                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return str(process.pid)
        result_command = " ".join(json.dumps(arg, ensure_ascii=False) for arg in (
            sys.executable, str(Path(__file__).resolve()), "_result",
            str(self.file(record["runs"][-1]["run"], "result")), self.unit))
        result_command = result_command.replace("$", "$$")
        processes_command = " ".join(json.dumps(arg, ensure_ascii=False) for arg in (
            sys.executable, str(Path(__file__).resolve()), "_processes",
            str(self.file(record["runs"][-1]["run"], "processes")), "systemd",
            record["runs"][-1]["marker"])).replace("$", "$$")
        spawn = ["systemd-run", "--user", "--collect", "--quiet", f"--unit={self.unit}",
                 "--expand-environment=no", f"--working-directory={record['worktree']}",
                 "-p", f"MemoryMax={record['memory']}", "-p", f"ExecStop=-{processes_command}",
                 "-p", f"ExecStopPost=-{result_command}"]
        run(spawn + [f"--setenv={k}={v}" for k, v in env.items()] + command, env=BUS)
        return run(["systemctl", "--user", "show", "-p", "MainPID", "--value", self.unit], env=BUS)

    def signal_process(self, number: int, sig: int) -> None:
        pid = self.pid(number)
        if not pid.isdigit() or int(pid) <= 0:
            return
        try:
            os.kill(int(pid), 0)
        except ProcessLookupError:
            return
        except PermissionError:
            pass
        entry = self.load()["runs"][number - 1]
        if entry.get("pid_start"):
            identity = process_identity(pid, entry.get("backend"))
            owned = identity is not None and identity[1] == entry["pid_start"]
        else:
            try:
                result = subprocess.run(["ps", "-ww", "-o", "command=", "-p", pid],
                                        capture_output=True, text=True, timeout=2)
                command = re.compile(r"(?:^|\s)" + re.escape(str(self.run_dir / f"run-{number}")) + r"(?:\s|$)")
                owned = result.returncode == 0 and command.search(result.stdout) is not None
            except (OSError, subprocess.TimeoutExpired):
                owned = False
        if not owned:
            raise Fail(f"{self.id} run {number} PID {pid}: process identity unconfirmed; no signal sent")
        self.file(number, "stop").touch()
        with contextlib.suppress(ProcessLookupError):
            os.killpg(int(pid), sig)

    def stop_process(self, number: int) -> None:
        if sys.platform == "darwin":
            if self.alive(number):
                self.signal_process(number, signal.SIGTERM)
        else:
            self.file(number, "stop").touch()
            run(["systemctl", "--user", "stop", self.unit], env=BUS)

    def refresh(self, stopped: bool = False, auto_clean: bool = True) -> dict:
        with self.locked():
            record = self.load()
            changed = self.read_outcomes(record)
            last = (record.get("runs") or [{}])[-1]
            if not last or (not stopped and self.alive(last["run"])):
                if last and (last.get("end") or record["status"] != "running"):
                    for key in ("end", "exit", "cost_usd"):
                        last.pop(key, None)
                    record["status"] = "running"
                    (self.dir / "final.md").unlink(missing_ok=True)
                    changed = True
                if changed:
                    self.save(record)
                return record
            changed = self.read_outcomes(record) or changed
            if not last.get("systemd") and last.get("backend") != "nohup" and sys.platform != "darwin":
                outcome = unit_outcome(self.unit)
                if outcome.get("result"):
                    last["systemd"] = outcome
                    changed = True
            if not last.get("end"):
                code = self.file(last["run"], "exit").read_text().strip() if self.file(last["run"], "exit").exists() else ""
                cost, final = 0, None
                for event in events(self.file(last["run"], "jsonl")):
                    if event.get("type") == "session":
                        record["session"] = event.get("id")
                    text = assistant_text(event)
                    if text is not None:
                        final = text
                        cost += ((event["message"].get("usage") or {}).get("cost") or {}).get("total") or 0
                last.update(end=now(), exit=int(code) if code.lstrip("-").isdigit() else None, cost_usd=round(cost, 6))
                changed = True
                record["status"] = "stopped" if stopped else "exited"
                if final:
                    (self.dir / "final.md").write_text(final + "\n")
                else:
                    (self.dir / "final.md").unlink(missing_ok=True)
            if changed:
                self.save(record)
            if github(record) and record.get("pr") and (not record.get("merge") or not record.get("merged_head")):
                try:
                    pr = json.loads(run(["gh", "pr", "view", record["pr"], "--json", "state,mergeCommit,headRefOid"]))
                    if pr.get("state") == "MERGED":
                        record.update(merge=(pr.get("mergeCommit") or {}).get("oid") or "",
                                      merged_head=pr.get("headRefOid") or "")
                        self.save(record)
                except (Fail, ValueError) as error:
                    print(f"lane: {self.id} PR refresh: {error}", file=sys.stderr)
            if auto_clean and record.get("merge") and not record.get("cleaned"):
                before = json.dumps(record)
                try:
                    record["cleanup"] = cleanup(self, record)
                except (Fail, OSError) as error:
                    record["cleanup"] = f"error: {error}"
                if json.dumps(record) != before:
                    self.save(record)
                if record["cleanup"].startswith(("left ", "error: ")):
                    print(f"lane: {self.id} cleanup: {record['cleanup']}", file=sys.stderr)
            return record

    def begin_run(self, record: dict, text: str, resume: bool, max_time: str) -> int:
        """Append a run and launch it. Caller holds the lock, so no refresh sees the run before its pid."""
        number = len(record["runs"]) + 1
        record["runs"].append({"run": number, "start": now(), "max_time": max_time,
                               "backend": "nohup" if sys.platform == "darwin" else "systemd",
                               "marker": f"{self.id}:{number}:{uuid.uuid4().hex}"})
        self.save({**record, "status": "running"})
        argv = ["omp", "-p", "--mode", "json", "--model", record["model"], "--thinking", record["thinking"],
                f"--max-time={max_time}",
                "--append-system-prompt", str(ENGINE / "roles" / "lane.md")] + ["--resume", record["session"]] * resume
        env = {**{k: os.environ[k] for k in PASS_ENV if os.environ.get(k)}, "TSTACK_LANE": self.id, "TSTACK_SEAT": str(self.seat)}
        command = ["/bin/sh", "-c", RUNNER, str(self.run_dir / f"run-{number}"), sys.executable, str(Path(__file__).resolve()),
                   record["runs"][-1]["backend"], record["runs"][-1]["marker"], *argv, text]
        pid = self.start_process(command, record, env)
        self.file(number, "pid").write_text(f"{pid}\n")
        identity = process_identity(pid, record["runs"][-1]["backend"]) if pid.isdigit() and int(pid) > 0 else None
        if identity is not None:
            record["runs"][-1]["pid_start"] = identity[1]
            self.save({**record, "status": "running"})
        return number


def github(record: dict):
    """OWNER/REPO when the lane's repo is on GitHub; old records may hold None, local lanes a path."""
    repo = record.get("repo") or "/"
    return None if repo.startswith("/") else repo


def find_pr(lane: Lane, record: dict) -> str:
    """The PR URL, recorded or found by branch; '' when there is none or the repo is not on GitHub."""
    if record.get("pr") or not github(record):
        return record.get("pr") or ""
    found = json.loads(run(["gh", "pr", "list", "--repo", github(record), "--head", record["branch"], "--state", "all",
                            "--json", "url", "--limit", "1"]) or "[]")
    if found:
        lane.update(pr=found[0]["url"])
    return found[0]["url"] if found else ""


def start(seat: Path, a) -> str:
    if Path(a.repo).expanduser().is_dir():
        main = Path(git(Path(a.repo).expanduser(), "rev-parse", "--show-toplevel"))
        origin = git(main, "remote", "get-url", "origin", check=False)
        match = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?$", origin)
        slug = match.group(1) if match else None
    else:
        slug = origin = a.repo
        main = WORKTREES / slug.split("/")[-1] / "main"
        if not main.exists():
            run(["gh", "repo", "clone", slug, str(main)])
    project = slug.split("/")[-1] if slug else main.name
    base = a.base or (git(main, "symbolic-ref", "--short", "refs/remotes/origin/HEAD", check=False).partition("/")[2]
                      or git(main, "rev-parse", "--abbrev-ref", "HEAD"))
    if origin:
        git(main, "fetch", "--quiet", "origin", base)
    stem = f"{project}-{re.sub(r'[^a-z0-9]+', '-', a.name.lower()).strip('-')[:40]}"
    for number in itertools.count(1):
        with contextlib.suppress(FileExistsError):
            (seat / "state" / "lanes" / f"{stem}-{number}").mkdir(parents=True)
            break
    lane = Lane(seat, f"{stem}-{number}")
    worktree, branch, brief = WORKTREES / project / lane.id, f"lane/{lane.id}", Path(a.brief).read_text()
    field = re.search(r"^PLAYBOOK:[ \t]*(.*)$", brief, re.MULTILINE | re.IGNORECASE)
    playbook = field.group(1).strip() if field else None
    if playbook is not None:
        playbooks = {"none"} | {path.stem for path in (ENGINE / "pstack" / "skills" / "poteto-mode" / "playbooks").glob("*.md")
                               if path.is_file()}
        if playbook not in playbooks:
            print(f"lane: unknown PLAYBOOK {playbook!r}; valid names: {', '.join(sorted(playbooks))}", file=sys.stderr)
    git(main, "worktree", "add", "--quiet", "-b", branch, str(worktree), f"origin/{base}" if origin else base)
    (lane.dir / "brief.md").write_text(brief)
    record = {"id": lane.id, "project": project, "seat": str(seat),
              "host": os.environ.get("TSTACK_MACHINE") or socket.gethostname().split(".")[0],
              "repo": slug or str(main), "cleanup_repo": git(main, "rev-parse", "--path-format=absolute", "--git-common-dir"),
              "worktree": str(worktree), "branch": branch, "base": base, "model": a.model,
              "thinking": a.thinking, "memory": a.memory, "playbook": playbook,
              "session": None, "status": "running", "pr": None,
              "runs": [], "created": now()}
    text = (f"You are lane {lane.id}, in {worktree} on branch {branch} (base {base}, repo {record['repo']}). "
            f"Your brief, also at {lane.dir / 'brief.md'}:\n\n{brief}")
    with lane.locked():
        lane.begin_run(record, text, resume=False, max_time=a.max_time)
    return lane.id


def resume(lane: Lane, text: str, memory: str | None, max_time: str) -> str:
    lane.refresh()
    with lane.locked():
        record = lane.load()
        if record["status"] == "running":
            raise Fail(f"{lane.id} is running run {len(record['runs'])}; `lane stop {lane.id}` first")
        if not record.get("session"):
            raise Fail(f"{lane.id} has no omp session to resume")
        if record.get("cleaned") or not Path(record["worktree"]).is_dir():
            raise Fail(f"{lane.id} worktree is missing or cleaned; cannot resume")
        previous = {**record, "runs": list(record["runs"])}
        if memory is not None:
            record["memory"] = memory
        if record["runs"] and lane.alive(record["runs"][-1]["run"]):
            raise Fail(f"{lane.id} is running run {len(record['runs'])}; `lane stop {lane.id}` first")
        try:
            return f"{lane.id} run {lane.begin_run(record, text, resume=True, max_time=max_time)}"
        except Fail:
            lane.save(previous)
            raise


def stop(lane: Lane) -> str:
    record = lane.refresh()
    if record["status"] != "running":
        return f"{lane.id} is not running ({record['status']})"
    number = record["runs"][-1]["run"]
    lane.stop_process(number)
    deadline = time.monotonic() + 90
    while lane.alive(number) and time.monotonic() < deadline:
        time.sleep(0.2)
    if lane.alive(number):
        lane.signal_process(number, signal.SIGKILL)
    lane.refresh(stopped=True)
    return f"{lane.id} stopped (run {number})"


def merge(lane: Lane, admin: bool) -> str:
    record = lane.refresh()
    url = find_pr(lane, record)
    if not url:
        raise Fail(f"no PR for {record['branch']} in {record['repo']}")
    pr = json.loads(run(["gh", "pr", "view", url, "--json", "headRefOid,body,reviews,comments"]))
    head = pr["headRefOid"]
    verdict = verdict_fact(pr, record.get("model"))
    print(render_verdict(verdict), flush=True)
    if not verdict["ready"]:
        raise Fail(f"merge requires a READY other-family verdict on current head {head}")
    # Run outside any clone, so gh deletes only the remote branch and leaves the worktree's checkout alone.
    run(["gh", "pr", "merge", url, "--squash", "--delete-branch", "--match-head-commit", head]
        + ["--admin"] * admin, cwd="/")
    after = json.loads(run(["gh", "pr", "view", url, "--json", "state,mergeCommit"]))
    if after.get("state") != "MERGED":
        raise Fail(f"PR was not merged: {url}")
    sha = (after.get("mergeCommit") or {}).get("oid") or ""
    lane.update(pr=url, merge=sha, merged_head=head)
    lane.refresh()
    return f"merged: {url} at {head[:12]} as {sha[:12]}"


REGENERABLE_DIRS = {
    "node_modules", ".build", ".swiftpm", "DerivedData", "dist", "build", "target", "__pycache__",
    ".venv", "venv", "coverage", ".next", ".turbo", ".cache", "out", ".omp", ".agents",
    ".pytest_cache", ".mypy_cache", ".ruff_cache",
}
REGENERABLE_FILES = {"AGENTS.override.md", "WORKFLOW.md", ".DS_Store", ".omp", ".agents"}


def process_cwds() -> list:
    command = ["lsof", "-nP", "-a", "-d", "cwd", "-Fpn"]
    if os.geteuid() != 0:
        command = ["sudo", "-n", *command]
    try:
        result = subprocess.run(command, cwd="/", capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        raise Fail("lsof timed out after 30s") from None
    if result.returncode or result.stderr.strip():
        raise Fail((result.stderr or result.stdout).strip() or f"lsof exited {result.returncode}")
    output = result.stdout
    found, pid = [], ""
    for line in output.splitlines():
        if line.startswith("p"):
            pid = line[1:]
        elif line.startswith("n") and line[1:].startswith("/"):
            found.append((pid, Path(line[1:]).resolve()))
    return found


def tree_gates(worktree: Path, expected_head: str | None, processes=None) -> list:
    failures = []
    if expected_head is not None and git(worktree, "rev-parse", "HEAD") != expected_head:
        failures.append("gate 2: HEAD differs from PR head")
    if git(worktree, "status", "--porcelain", "--untracked-files=all"):
        failures.append("gate 3: dirty worktree")
    ignored = git(worktree, "ls-files", "-z", "--others", "--ignored", "--exclude-standard").split("\0")
    collapsed = git(worktree, "ls-files", "-z", "--others", "--ignored", "--exclude-standard", "--directory")
    unsafe = []
    for root in collapsed.split("\0"):
        if not root:
            continue
        root_depth = len(Path(root).parts) - 1
        files = (name for name in ignored if name.startswith(root)) if root.endswith("/") else (root,)
        if any(not any(part in REGENERABLE_DIRS for part in Path(name).parts[root_depth:-1])
               and Path(name).name not in REGENERABLE_FILES for name in files):
            unsafe.append(root)
    if unsafe:
        failures.append("gate 4: ignored paths are not regenerable")
    try:
        processes = process_cwds() if processes is None else processes
        if isinstance(processes, str):
            raise Fail(processes)
        root = worktree.resolve()
        pids = [pid for pid, cwd in processes if cwd == root or root in cwd.parents]
        if pids:
            failures.append(f"gate 5: process cwd inside worktree, PIDs {', '.join(pids)}")
    except (Fail, OSError) as error:
        failures.append(f"gate 5: process inspection failed: {error}")
    return failures


def clean_listing(seat: Path) -> str:
    instances = {Path.home() / "agents", Path(os.environ.get("TSTACK_INSTANCE") or Path.home() / "agents")}
    seats = {seat}
    for instance in instances:
        seats.add(instance / "assistant")
        seats.update((instance / "projects").glob("*"))
    recorded = set()
    for candidate in seats:
        for path in (candidate / "state" / "lanes").glob("*/lane.json"):
            try:
                record = json.loads(path.read_text())
            except (OSError, ValueError) as error:
                raise Fail(f"{path}: {error}") from None
            if record.get("worktree"):
                recorded.add(Path(record["worktree"]).resolve())
    try:
        processes = process_cwds()
    except (Fail, OSError) as error:
        processes = str(error)
    inventories, rows = {}, []
    scanned = finished = eligible = errors = 0
    for directory, dirs, files in os.walk(WORKTREES, followlinks=False):
        if ".git" not in dirs and ".git" not in files:
            continue
        dirs[:] = []
        worktree = Path(directory)
        if worktree.resolve() in recorded or worktree.name == "main":
            continue
        scanned += 1
        try:
            branch = git(worktree, "symbolic-ref", "--quiet", "--short", "HEAD", check=False)
            if not branch or branch in {"main", "master"}:
                continue
            origin = git(worktree, "remote", "get-url", "origin")
            match = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?$", origin)
            if not match:
                continue
            repo = match[1]
            if repo not in inventories:
                inventories[repo] = json.loads(run([
                    "gh", "pr", "list", "--repo", repo, "--state", "all", "--limit", "1000", "--json",
                    "url,state,headRefName,headRefOid,mergedAt,closedAt,updatedAt"]))
            matches = [pr for pr in inventories[repo] if pr["headRefName"] == branch]
            if not matches:
                continue
            pr = max(matches, key=lambda item: item.get("updatedAt") or "")
            if pr["state"] not in {"MERGED", "CLOSED"}:
                continue
            timestamp = pr.get("mergedAt") or pr.get("closedAt")
            failures = []
            if not timestamp:
                failures.append("gate 1: terminal time unavailable")
            elif (dt.datetime.now(dt.timezone.utc) - dt.datetime.fromisoformat(
                    timestamp.replace("Z", "+00:00"))).total_seconds() <= 86400:
                failures.append("gate 1: terminal PR is not over 24 hours old")
            failures += tree_gates(worktree, pr.get("headRefOid") or "", processes)
            finished += 1
            eligible += not failures
            rows.append(f"{worktree}\t{pr['state']}\t{pr['url']}\t"
                        + ("; ".join(failures) if failures else "all gates pass"))
        except (Fail, OSError, ValueError) as error:
            errors += 1
            rows.append(f"{worktree}\tUNKNOWN\tinspection failed: {error}")
    rows.append(f"unrecorded: {scanned}, finished: {finished}, eligible: {eligible}, "
                f"blocked: {finished - eligible}, errors: {errors}")
    return "\n".join(rows)


def cleanup(lane: Lane, record: dict) -> str:
    worktree, done = Path(record["worktree"]), []
    if record["status"] == "running":
        return "left running lane"
    repo = record.get("cleanup_repo")
    if not repo:
        if worktree.exists():
            repo = git(worktree, "rev-parse", "--path-format=absolute", "--git-common-dir")
        else:
            original = (Path(record["repo"]) if (record.get("repo") or "").startswith("/")
                        else WORKTREES / record["project"] / "main")
            if not original.is_dir():
                return "left branch: original repository unavailable"
            repo = git(original, "rev-parse", "--path-format=absolute", "--git-common-dir")
        record["cleanup_repo"] = repo
        lane.save(record)

    def refusal(head, target):
        if record.get("merge"):
            if not record.get("merged_head"):
                return f"left {target}: merged head unavailable"
            if head != record["merged_head"]:
                return f"left {target}: HEAD differs from merged head"
        elif git(repo, "remote", "get-url", "origin", check=False):
            git(repo, "fetch", "--quiet", "origin")
            if not git(repo, "for-each-ref", f"--contains={head}", "--format=%(refname)", "refs/remotes/origin"):
                return f"left {target}: unpushed commits"
        elif git(repo, "merge-base", head, f"refs/heads/{record['base']}", check=False) != head:
            return f"left {target}: unpushed commits"
        return ""

    if worktree.exists():
        expected_head = record.get("merged_head") if record.get("merge") else None
        if record.get("pr") and not record.get("merge"):
            expected_head = json.loads(run(["gh", "pr", "view", record["pr"], "--json", "headRefOid"])).get("headRefOid") or ""
        failures = tree_gates(worktree, expected_head)
        if failures:
            return "left worktree: " + "; ".join(failures)
        branch = git(worktree, "symbolic-ref", "--quiet", "--short", "HEAD", check=False)
        if not branch:
            return "left worktree on detached HEAD"
        if branch != record["branch"]:
            return "left worktree on another branch"
        reason = refusal(git(worktree, "rev-parse", "HEAD"), "worktree")
        if reason:
            return reason
        git(repo, "worktree", "remove", str(worktree))
        done.append(f"removed worktree {worktree}")
    branch = git(repo, "rev-parse", "--verify", f"refs/heads/{record['branch']}", check=False)
    if branch:
        reason = refusal(branch, "branch")
        if reason:
            return reason
        git(repo, "worktree", "prune")
        done.append(git(repo, "branch", "-D", record["branch"]))
    for entry in record.get("runs") or []:
        for ext in ("jsonl", "err", "exit", "exit.tmp", "pid", "tmp", "result", "result.tmp",
                    "processes", "processes.tmp", "agent", "agent.tmp", "stop"):
            lane.file(entry["run"], ext).unlink(missing_ok=True)
    record["cleaned"] = now()
    return "\n".join(done) or "already clean"


def clean(lane: Lane) -> str:
    find_pr(lane, lane.load())
    lane.refresh(auto_clean=False)
    with lane.locked():
        record = lane.load()
        try:
            result = cleanup(lane, record)
        except (Fail, OSError) as error:
            record["cleanup"] = f"error: {error}"
            lane.save(record)
            raise
        record["cleanup"] = result
        lane.save(record)
        return result


def summary(record: dict) -> tuple:
    pr = record.get("pr") or "-"
    return (record.get("runs") or [{}])[-1], pr, f"${sum(r.get('cost_usd') or 0 for r in record.get('runs') or []):.2f}"


def listing(seat: Path, show_all: bool) -> str:
    root, rows = seat / "state" / "lanes", []
    for lane in [Lane(seat, p.name) for p in sorted(root.iterdir()) if (p / "lane.json").exists()] if root.is_dir() else []:
        record = lane.load()
        lane.read_outcomes(record)
        last = (record.get("runs") or [{}])[-1]
        if last.get("systemd") and record["status"] == "running":
            record["status"] = "exited"
        if show_all or Path(record["worktree"]).exists():
            if record["status"] != "running" and not record.get("cleaned") and last and lane.alive(last["run"]):
                record["status"] = "running"
                for key in ("end", "exit", "cost_usd"):
                    last.pop(key, None)
            last, pr, cost = summary(record)
            reason = (last.get("systemd") or {}).get("result")
            status = record["status"] + (f" ({reason})" if reason and reason != "success" else "")
            rows.append(f"{lane.id}\t{status}\texit {exit_code(last)}\t{cost}\t{pr}\t"
                        f"{last.get('end') or last.get('start') or record.get('created')}")
    return "\n".join(rows)


def show(lane: Lane) -> str:
    try:
        pr = find_pr(lane, lane.load()) or "-"
    except Fail as error:
        pr = f"? ({error})"
    record = lane.refresh()
    last, _, cost = summary(record)
    final = lane.dir / "final.md"
    out = [f"{lane.id}: {record['status']}, run {last.get('run', 0)} exit {exit_code(last)}, {cost}",
           f"repo {record['repo']}, branch {record['branch']} on {record['base']}, PR {pr}",
           f"worktree {record['worktree']}" + ("" if Path(record["worktree"]).exists() else " (removed)"),
           f"model {record['model']} {record['thinking']}, session {record.get('session')}",
           f"PLAYBOOK: {record.get('playbook') if record.get('playbook') is not None else '(absent)'}"]
    out += [f"run {r['run']}: {r.get('start')} to {r.get('end') or 'running'}, exit {exit_code(r)}, "
            f"max-time {r.get('max_time', '(unrecorded)')}, ${r.get('cost_usd') or 0:.2f}" for r in record.get("runs") or []]
    out += process_lines(record.get("runs") or [])
    if record["status"] == "running":
        return "\n".join(out + ["final answer: run in progress"])
    if final.exists():
        return "\n".join(out + ["final answer (last 20 lines):", *final.read_text().splitlines()[-20:]])
    return "\n".join(out + [f"final answer: none (run {last.get('run', 0)} ended without one)"])


def logs(lane: Lane, lines: int) -> str:
    """The latest run as readable lines: assistant text and tool calls, then stderr."""
    number, out = len(lane.load().get("runs") or [{}]), []
    for event in events(lane.file(number, "jsonl")):
        if assistant_text(event):
            out.append(assistant_text(event))
        elif event.get("type") == "tool_execution_start":
            out.append(f"> {event.get('toolName')}: {event.get('intent') or json.dumps(event.get('args'))[:200]}")
    err = lane.file(number, "err").read_text().strip() if lane.file(number, "err").exists() else ""
    return "\n".join("\n".join(out + ["stderr:", err] * bool(err)).splitlines()[-lines:])


def wait(lanes: list) -> str:
    for lane in lanes:
        lane.load()
    while True:
        for lane in lanes:
            record = lane.refresh()
            if record["status"] != "running":
                final = lane.dir / "final.md"
                answer = final.read_text().rstrip("\n") if final.exists() else "(no final answer)"
                last = (record.get("runs") or [{}])[-1]
                return "\n".join([f"{lane.id} {record['status']} exit {exit_code(last)}",
                                  *process_lines([last]), answer])
        time.sleep(2)


def main(argv) -> int:
    top = argparse.ArgumentParser(prog="lane", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub, p = top.add_subparsers(dest="cmd", required=True), {}
    for name, args, text in (
            ("start", ["name"], "make the worktree, start the first run detached, print the lane id"),
            ("resume", ["id", "text"], "new run in the same omp session, prompted with TEXT"),
            ("list", [], "read-only cached lane status, exit, cost, PR, and last run time"),
            ("show", ["id"], "the lane's facts and the tail of its final answer"),
            ("logs", ["id"], "the latest run as readable lines"),
            ("wait", ["ids"], "block until a run of any listed lane ends; print its id, exit and final answer"),
            ("stop", ["id"], "stop the running run"),
            ("merge", ["id"], "require a READY other-family verdict on the current head, squash-merge and delete the branch"),
            ("clean", ["id"], "remove the worktree and delete the local branch")):
        p[name] = sub.add_parser(name, help=text, description=text)
        p[name].add_argument("--seat", help="seat dir (default $TSTACK_SEAT, else the nearest ancestor with state/)")
        for arg in args:
            p[name].add_argument(arg, nargs="+" if arg == "ids" else "?" if name == "clean" else None)
    p["start"].add_argument("--repo", required=True, help="OWNER/REPO (cloned to ~/worktrees/<repo>/main if absent) or a clone")
    p["start"].add_argument("--brief", required=True,
                           help="brief file; optional PLAYBOOK: name line is recorded, unknown names are reported")
    p["start"].add_argument("--base", help="default: origin's default branch, else the clone's current branch")
    p["start"].add_argument("--model", default="@sol")
    p["start"].add_argument("--thinking", default="high")
    for name in ("start", "resume"):
        p[name].add_argument("--max-time", required=True,
                             help="required omp hard deadline for this run, e.g. 600, 10m, 1h; no default or reuse")
        p[name].add_argument("--memory", default="8G" if name == "start" else None,
                             help="MemoryMax of the run's systemd unit on Linux; ignored on macOS"
                                  + (" (default: reuse the previous cap)" if name == "resume" else ""))
    p["list"].add_argument("--all", action="store_true", help="include lanes whose worktree is gone")
    p["logs"].add_argument("-n", type=int, default=60)
    p["merge"].add_argument("--admin", action="store_true")
    p["clean"].add_argument("--list", action="store_true",
                            help="read-only: list unrecorded terminal-PR trees and gates 1–5 under ~/worktrees")
    a = top.parse_args(argv)
    if a.cmd == "clean" and bool(a.id) == bool(a.list):
        p["clean"].error("pass a lane id or --list")
    if a.seat or os.environ.get("TSTACK_SEAT"):
        seat = Path(a.seat or os.environ["TSTACK_SEAT"]).expanduser().resolve()
    else:
        seat = next((d for d in (Path.cwd().resolve(), *Path.cwd().resolve().parents) if (d / "state").is_dir()), None)
        if not seat and a.cmd == "clean" and a.list:
            seat = Path(os.environ.get("TSTACK_INSTANCE") or Path.home() / "agents") / "assistant"
        if not seat:
            raise Fail("no seat: pass --seat DIR, set TSTACK_SEAT, or run inside a seat dir")
    lane = Lane(seat, a.id) if getattr(a, "id", None) else None
    out = {"start": lambda: start(seat, a), "resume": lambda: resume(lane, a.text, a.memory, a.max_time), "list": lambda: listing(seat, a.all),
           "show": lambda: show(lane), "logs": lambda: logs(lane, a.n), "stop": lambda: stop(lane),
           "wait": lambda: wait([Lane(seat, i) for i in a.ids]), "merge": lambda: merge(lane, a.admin),
           "clean": lambda: clean_listing(seat) if a.list else clean(lane)}[a.cmd]()
    if out:
        print(out)
    return 0


if __name__ == "__main__":
    if len(sys.argv) >= 6 and sys.argv[1] == "_agent":
        path = Path(sys.argv[2])
        temporary = path.with_suffix(".agent.tmp")
        temporary.write_text(f"{os.getpid()}\n")
        temporary.replace(path)
        for name in ("SIGPIPE", "SIGXFZ", "SIGXFSZ"):
            if hasattr(signal, name):
                signal.signal(getattr(signal, name), signal.SIG_DFL)
        os.execvpe(sys.argv[4], sys.argv[4:], {**os.environ, "TSTACK_LANE_RUN": sys.argv[3]})
    if len(sys.argv) == 5 and sys.argv[1] == "_processes":
        capture_processes(Path(sys.argv[2]), sys.argv[3], sys.argv[4])
        sys.exit(0)
    if len(sys.argv) == 4 and sys.argv[1] == "_result":
        capture_result(Path(sys.argv[2]), sys.argv[3])
        sys.exit(0)
    if sys.argv[1:] == ["_stream"]:
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        filter_stream(sys.stdin, sys.stdout)
        sys.exit(0)
    try:
        sys.exit(main(sys.argv[1:]))
    except Fail as error:
        sys.exit(f"lane: {error}")
