#!/usr/bin/env python3
"""lane: run one task as a detached `omp -p` session in its own worktree.

A lane lives in <seat>/state/lanes/<id>/ (lane.json, brief.md, final.md). Each run's omp json stream,
stderr, exit code and pid sit in <seat>/state/run/lanes/<id>/run-<n>.{jsonl,err,exit,pid}.
"""

import argparse
import contextlib
import datetime as dt
import fcntl
import json
import os
import re
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
ENGINE = Path(os.environ.get("TSTACK_HOME") or Path(__file__).resolve().parents[1])
WORKTREES = Path(os.environ.get("TSTACK_WORKTREES") or HOME / "worktrees")
SYSTEMD = (os.environ.get("TSTACK_LAUNCHER") or ("process" if sys.platform == "darwin" else "systemd")) == "systemd"
PASS_ENV = ("PATH", "HOME", "USER", "SHELL", "LANG", "LC_ALL", "TERM", "TMPDIR", "SSH_AUTH_SOCK", "EASL_SOCKET",
            "TSTACK_HOME", "TSTACK_INSTANCE", "TSTACK_WORKTREES", "TSTACK_MACHINE")
# Terminals easld spawns from a system unit lack the user bus that systemctl --user needs.
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
BUS = {**os.environ, "XDG_RUNTIME_DIR": RUNTIME,
       "DBUS_SESSION_BUS_ADDRESS": os.environ.get("DBUS_SESSION_BUS_ADDRESS") or f"unix:path={RUNTIME}/bus"}
# The run goes through sh so its exit code outlives the detached process that ran it.
RUNNER = '"$@" > "$0.jsonl" 2> "$0.err"; echo $? > "$0.exit"'


class Fail(Exception):
    pass


def now() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def exit_code(run_entry: dict) -> str:
    return "-" if run_entry.get("exit") is None else str(run_entry["exit"])


def run(argv, cwd=None, env=None, check=True) -> subprocess.CompletedProcess:
    try:
        result = subprocess.run(argv, cwd=cwd, env=env, capture_output=True, text=True)
    except FileNotFoundError:
        raise Fail(f"{argv[0]}: not found")
    if check and result.returncode:
        raise Fail(f"{' '.join(map(str, argv[:4]))}: {(result.stderr or result.stdout).strip()}")
    return result


def git(repo, *args, check=True) -> str:
    return run(["git", "-C", str(repo), *args], check=check).stdout.strip()


def find_seat(explicit) -> Path:
    if explicit or os.environ.get("TSTACK_SEAT"):
        return Path(explicit or os.environ["TSTACK_SEAT"]).expanduser().resolve()
    here = Path.cwd().resolve()
    seat = next((p for p in (here, *here.parents) if (p / "state").is_dir()), None)
    if not seat:
        raise Fail("no seat: pass --seat DIR, set TSTACK_SEAT, or run inside a seat dir")
    return seat


def read_stream(path: Path):
    """Session id, summed cost and final answer (the last assistant message's text) of an omp json stream."""
    session, cost, final = None, 0.0, None
    for line in path.read_text(errors="replace").splitlines() if path.exists() else []:
        try:
            event = json.loads(line)
        except ValueError:
            continue
        message = event.get("message") or {}
        if event.get("type") == "session":
            session = session or event.get("id")
        elif event.get("type") == "message_end" and message.get("role") == "assistant":
            cost += float(((message.get("usage") or {}).get("cost") or {}).get("total") or 0)
            final = "\n".join(c.get("text", "") for c in message.get("content") or [] if c.get("type") == "text").strip()
    return session, round(cost, 6), final or None


class Lane:
    def __init__(self, seat: Path, lane_id: str):
        self.seat, self.id = seat, lane_id
        self.dir = seat / "state" / "lanes" / lane_id
        self.run_dir = seat / "state" / "run" / "lanes" / lane_id
        self.unit = f"tstack-lane-{lane_id}"

    def base(self, number: int) -> Path:
        return self.run_dir / f"run-{number}"

    def load(self) -> dict:
        try:
            return json.loads((self.dir / "lane.json").read_text())
        except FileNotFoundError:
            raise Fail(f"no lane {self.id} in {self.seat}")

    def save(self, record: dict) -> None:
        record["updated"] = now()
        tmp = self.dir / ".lane.json.tmp"
        tmp.write_text(json.dumps(record, indent=1) + "\n")
        os.replace(tmp, self.dir / "lane.json")

    @contextlib.contextmanager
    def locked(self):
        self.run_dir.mkdir(parents=True, exist_ok=True)
        with open(self.run_dir / "lock", "a") as handle:
            fcntl.flock(handle, fcntl.LOCK_EX)
            yield

    def update(self, **fields) -> None:
        with self.locked():
            record = self.load()
            record.update(fields)
            self.save(record)

    def alive(self, number: int) -> bool:
        base = self.base(number)
        pid_file = Path(f"{base}.pid")
        if Path(f"{base}.exit").exists() or not pid_file.exists():
            return False
        pid = pid_file.read_text().strip()
        command = run(["ps", "-ww", "-o", "command=", "-p", pid], check=False).stdout if pid.isdigit() else ""
        return str(base) in command

    def refresh(self, stopped: bool = False) -> dict:
        """Record the latest run's end once its process is gone (or `stopped`): exit, cost, session, final.md."""
        with self.locked():
            record = self.load()
            last = (record.get("runs") or [{}])[-1]
            if not last or last.get("end") or (not stopped and self.alive(last["run"])):
                return record
            base = self.base(last["run"])
            exit_file = Path(f"{base}.exit")
            code = exit_file.read_text().strip() if exit_file.exists() else ""
            session, cost, final = read_stream(Path(f"{base}.jsonl"))
            last.update(end=now(), exit=int(code) if code.lstrip("-").isdigit() else None, cost_usd=cost)
            record["session"] = session or record.get("session")
            record["status"] = "stopped" if stopped else "exited"
            if final:
                (self.dir / "final.md").write_text(final + "\n")
            else:
                (self.dir / "final.md").unlink(missing_ok=True)
            self.save(record)
            return record

    def begin_run(self, record: dict, text: str, resume: bool) -> int:
        """Append a run and launch it. Caller holds the lock, so no refresh sees the run before its pid."""
        number = len(record["runs"]) + 1
        record["runs"].append({"run": number, "start": now()})
        record["status"] = "running"
        self.save(record)
        argv = ["omp", "-p", "--mode", "json", "--model", record["model"], "--thinking", record["thinking"],
                "--append-system-prompt", str(ENGINE / "roles" / "lane.md")]
        argv += ["--resume", record["session"]] if resume else []
        base = self.base(number)
        env = {k: os.environ[k] for k in PASS_ENV if os.environ.get(k)}
        env.update(TSTACK_LANE=self.id, TSTACK_SEAT=str(self.seat))
        command = ["sh", "-c", RUNNER, str(base), *argv, text]
        if SYSTEMD:
            spawn = ["systemd-run", "--user", "--collect", "--quiet", f"--unit={self.unit}",
                     f"--working-directory={record['worktree']}", "-p", f"MemoryMax={record['memory']}"]
            cpus = run(["systemctl", "show", "agents.slice", "-p", "AllowedCPUs", "--value"], check=False).stdout.strip()
            spawn += ["-p", f"CPUAffinity={cpus}"] if cpus else []
            run(spawn + [f"--setenv={k}={v}" for k, v in env.items()] + command, env=BUS)
            pid = run(["systemctl", "--user", "show", "-p", "MainPID", "--value", self.unit], env=BUS).stdout
        else:
            pid = subprocess.Popen(command, cwd=record["worktree"], env=env, stdin=subprocess.DEVNULL,
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True).pid
        Path(f"{base}.pid").write_text(f"{str(pid).strip()}\n")
        return number


def all_lanes(seat: Path) -> list:
    root = seat / "state" / "lanes"
    return [Lane(seat, p.name) for p in sorted(root.iterdir()) if (p / "lane.json").exists()] if root.is_dir() else []


def github(record: dict):
    """OWNER/REPO when the lane's repo is on GitHub; old records may hold None, local lanes a path."""
    repo = record.get("repo") or "/"
    return None if repo.startswith("/") else repo


def main_clone(record: dict) -> Path:
    return WORKTREES / record["project"] / "main" if github(record) else Path(record["repo"])


def find_pr(lane: Lane, record: dict) -> str:
    """The PR URL, recorded or found by branch; '' when there is none or the repo is not on GitHub."""
    if record.get("pr") or not github(record):
        return record.get("pr") or ""
    found = json.loads(run(["gh", "pr", "list", "--repo", github(record), "--head", record["branch"], "--state", "all",
                            "--json", "url", "--limit", "1"]).stdout or "[]")
    if found:
        lane.update(pr=found[0]["url"])
    return found[0]["url"] if found else ""


def start(seat: Path, a) -> str:
    path = Path(a.repo).expanduser()
    if path.is_dir():
        main = Path(git(path, "rev-parse", "--show-toplevel"))
        origin = git(main, "remote", "get-url", "origin", check=False)
        match = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?$", origin)
        slug = match.group(1) if match else None
    else:
        slug, origin = a.repo, a.repo
        main = WORKTREES / slug.split("/")[-1] / "main"
        if not main.exists():
            run(["gh", "repo", "clone", slug, str(main)])
    project = slug.split("/")[-1] if slug else main.name
    base = a.base or (git(main, "symbolic-ref", "--short", "refs/remotes/origin/HEAD", check=False).partition("/")[2]
                      or git(main, "rev-parse", "--abbrev-ref", "HEAD"))
    if origin:
        git(main, "fetch", "--quiet", "origin", base)
    brief = Path(a.brief).read_text()
    stem, number = f"{project}-{re.sub(r'[^a-z0-9]+', '-', a.name.lower()).strip('-')[:40]}-", 1
    while True:
        try:
            (seat / "state" / "lanes" / f"{stem}{number}").mkdir(parents=True)
            break
        except FileExistsError:
            number += 1
    lane = Lane(seat, f"{stem}{number}")
    worktree, branch = WORKTREES / project / lane.id, f"lane/{lane.id}"
    git(main, "worktree", "add", "--quiet", "-b", branch, str(worktree), f"origin/{base}" if origin else base)
    (lane.dir / "brief.md").write_text(brief)
    record = {"id": lane.id, "project": project, "seat": str(seat),
              "host": os.environ.get("TSTACK_MACHINE") or socket.gethostname().split(".")[0],
              "repo": slug or str(main), "worktree": str(worktree), "branch": branch, "base": base, "model": a.model,
              "thinking": a.thinking, "memory": a.memory, "session": None, "status": "running", "pr": None,
              "runs": [], "created": now()}
    text = (f"You are lane {lane.id}, in {worktree} on branch {branch} (base {base}, repo {record['repo']}). "
            f"Your brief, also at {lane.dir / 'brief.md'}:\n\n{brief}")
    with lane.locked():
        lane.begin_run(record, text, resume=False)
    return lane.id


def resume(lane: Lane, text: str) -> int:
    lane.refresh()
    with lane.locked():
        record = lane.load()
        if record["status"] == "running":
            raise Fail(f"{lane.id} is running run {len(record['runs'])}; `lane stop {lane.id}` first")
        if not record.get("session"):
            raise Fail(f"{lane.id} has no omp session to resume")
        return lane.begin_run(record, text, resume=True)


def stop(lane: Lane) -> str:
    record = lane.refresh()
    if record["status"] != "running":
        return f"{lane.id} is not running ({record['status']})"
    number = record["runs"][-1]["run"]
    if SYSTEMD:
        run(["systemctl", "--user", "stop", lane.unit], env=BUS)
    else:
        with contextlib.suppress(ProcessLookupError, ValueError):
            os.killpg(int(Path(f"{lane.base(number)}.pid").read_text()), signal.SIGTERM)
    for _ in range(150):
        if not lane.alive(number):
            break
        time.sleep(0.2)
    lane.refresh(stopped=True)
    return f"{lane.id} stopped (run {number})"


def merge(lane: Lane, admin: bool, auto: bool) -> str:
    record = lane.refresh()
    url = find_pr(lane, record)
    if not url:
        raise Fail(f"no PR for {record['branch']} in {record['repo']}")
    head = json.loads(run(["gh", "pr", "view", url, "--json", "headRefOid"]).stdout)["headRefOid"]
    # Run outside any clone, so gh deletes only the remote branch and leaves the worktree's checkout alone.
    run(["gh", "pr", "merge", url, "--squash", "--delete-branch", "--match-head-commit", head]
        + ["--admin"] * admin + ["--auto"] * auto, cwd="/")
    after = json.loads(run(["gh", "pr", "view", url, "--json", "state,mergeCommit"]).stdout)
    if after.get("state") != "MERGED":
        return f"auto-merge armed: {url} at {head[:12]}"
    sha = (after.get("mergeCommit") or {}).get("oid") or ""
    lane.update(pr=url, merge=sha)
    return f"merged: {url} at {head[:12]} as {sha[:12]}"


def clean(lane: Lane) -> list:
    record = lane.refresh()
    main, worktree, done = main_clone(record), Path(record["worktree"]), []
    if worktree.exists():
        git(main, "worktree", "remove", str(worktree))
        done.append(f"removed worktree {worktree}")
    done.append(git(main, "branch", "-D", record["branch"]))
    return done


def facts(lane: Lane, record: dict) -> tuple:
    runs = record.get("runs") or [{}]
    try:
        pr = find_pr(lane, record) or "-"
    except Fail as error:
        pr = f"? ({error})"
    cost = sum(r.get("cost_usd") or 0 for r in record.get("runs") or [])
    return runs[-1], pr, f"${cost:.2f}"


def show(lane: Lane) -> str:
    record = lane.refresh()
    last, pr, cost = facts(lane, record)
    gone = "" if Path(record["worktree"]).exists() else " (removed)"
    out = [f"{lane.id}: {record['status']}, run {last.get('run', 0)} exit {exit_code(last)}, {cost}",
           f"repo {record['repo']}, branch {record['branch']} on {record['base']}, PR {pr}",
           f"worktree {record['worktree']}{gone}", f"model {record['model']} {record['thinking']}, session {record.get('session')}"]
    out += [f"run {r['run']}: {r.get('start')} to {r.get('end') or 'running'}, exit {exit_code(r)}, ${r.get('cost_usd') or 0:.2f}"
            for r in record.get("runs") or []]
    final = lane.dir / "final.md"
    if record["status"] == "running":
        out.append("final answer: run in progress")
    elif final.exists():
        out += ["final answer (last 20 lines):", *final.read_text().rstrip("\n").splitlines()[-20:]]
    else:
        out.append(f"final answer: none (run {last.get('run', 0)} ended without one)")
    return "\n".join(out)


def logs(lane: Lane, lines: int) -> str:
    """The latest run as readable lines: assistant text, tool calls and failures, then stderr."""
    record = lane.refresh()
    base = lane.base(len(record.get("runs") or [{}]))
    out = []
    stream = Path(f"{base}.jsonl")
    for line in stream.read_text(errors="replace").splitlines() if stream.exists() else []:
        with contextlib.suppress(ValueError):
            event = json.loads(line)
            message = event.get("message") or {}
            if event.get("type") == "message_end" and message.get("role") == "assistant":
                out += [c["text"].strip() for c in message.get("content") or [] if c.get("type") == "text" and c.get("text")]
            elif event.get("type") == "tool_execution_start":
                out.append(f"> {event.get('toolName')}: {event.get('intent') or json.dumps(event.get('args'))[:200]}")
            elif event.get("type") == "tool_execution_end" and event.get("isError"):
                out.append(f"! {event.get('toolName')} failed")
    err = Path(f"{base}.err")
    if err.exists() and err.read_text().strip():
        out += ["stderr:", err.read_text().strip()]
    return "\n".join("\n".join(out).splitlines()[-lines:]) or f"no output yet in {stream}"


def wait(lanes: list) -> str:
    for lane in lanes:
        lane.load()
    while True:
        for lane in lanes:
            record = lane.refresh()
            if record["status"] != "running":
                final = lane.dir / "final.md"
                answer = final.read_text().rstrip("\n") if final.exists() else "(no final answer)"
                return f"{lane.id} {record['status']} exit {exit_code((record.get('runs') or [{}])[-1])}\n{answer}"
        time.sleep(2)


def parser() -> argparse.ArgumentParser:
    top = argparse.ArgumentParser(prog="lane", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = top.add_subparsers(dest="cmd", required=True)

    def add(name, help_text, *ids):
        p = sub.add_parser(name, help=help_text, description=help_text)
        p.add_argument("--seat", help="seat dir (default $TSTACK_SEAT, else the nearest ancestor with state/)")
        for arg in ids:
            p.add_argument(arg, nargs="+" if arg == "ids" else None)
        return p

    p = add("start", "make the worktree, start the first run detached, print the lane id", "name")
    p.add_argument("--repo", required=True, help="OWNER/REPO (cloned to ~/worktrees/<repo>/main if absent) or a local clone")
    p.add_argument("--brief", required=True)
    p.add_argument("--base", help="default: origin's default branch, else the clone's current branch")
    p.add_argument("--model", default="@sol")
    p.add_argument("--thinking", default="high")
    p.add_argument("--memory", default="8G", help="MemoryMax of the run's systemd unit (Linux)")
    add("resume", "new run in the same omp session, prompted with TEXT", "id", "text")
    add("list", "one line per lane: status, exit, cost, PR, age").add_argument(
        "--all", action="store_true", help="include lanes whose worktree is gone")
    add("show", "the lane's facts and the tail of its final answer", "id")
    add("logs", "the latest run as readable lines", "id").add_argument("-n", type=int, default=60)
    add("wait", "block until a run of any listed lane ends; print its id, exit and final answer", "ids")
    add("stop", "stop the running run", "id")
    p = add("merge", "squash-merge the lane's PR at its current head and delete the branch", "id")
    p.add_argument("--admin", action="store_true")
    p.add_argument("--auto", action="store_true")
    add("clean", "remove the worktree and delete the local branch", "id")
    return top


def main(argv) -> int:
    a = parser().parse_args(argv)
    seat = find_seat(a.seat)
    lane = Lane(seat, a.id) if getattr(a, "id", None) else None
    if a.cmd == "start":
        print(start(seat, a))
    elif a.cmd == "resume":
        print(f"{a.id} run {resume(lane, a.text)}")
    elif a.cmd == "list":
        for item in all_lanes(seat):
            record = item.refresh()
            if a.all or Path(record["worktree"]).exists():
                last, pr, cost = facts(item, record)
                print(f"{item.id}\t{record['status']}\texit {exit_code(last)}\t{cost}\t{pr}\t"
                      f"{last.get('end') or last.get('start') or record.get('created')}")
    elif a.cmd == "show":
        print(show(lane))
    elif a.cmd == "logs":
        print(logs(lane, a.n))
    elif a.cmd == "wait":
        print(wait([Lane(seat, i) for i in a.ids]))
    elif a.cmd == "stop":
        print(stop(lane))
    elif a.cmd == "merge":
        print(merge(lane, a.admin, a.auto))
    elif a.cmd == "clean":
        print("\n".join(clean(lane)))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Fail as error:
        sys.exit(f"lane: {error}")
