#!/usr/bin/env python3
"""tstack: maintain this host's engine and instance.

setup  links skills, agents and bins and writes systemd units.
update pulls the engine, safely refreshes the instance and reruns setup.
commit pushes seat state through a private index and safely refreshes main.
board  draws grouped local project status and a You section on easl.
"""

from __future__ import annotations

import argparse
import fcntl
import html as htmlib
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import tempfile
from dataclasses import asdict, dataclass, field
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone
import math
import time
import unicodedata
from pathlib import Path

HOME = Path.home()
ENGINE = Path(os.environ.get("TSTACK_HOME") or Path(__file__).resolve().parents[1])
INSTANCE = Path(os.environ.get("TSTACK_INSTANCE") or HOME / "agents")
OMP = HOME / ".omp" / "agent"
FRONTEND_STUDIO = HOME / "worktrees" / "frontend-studio" / "main"
MATTPOCOCK_SKILLS = HOME / "worktrees" / "mattpocock-skills" / "main"
MANAGED_REPOS = (
    ("frontend-studio", FRONTEND_STUDIO, "https://github.com/twaldin/frontend-studio.git"),
    ("mattpocock-skills", MATTPOCOCK_SKILLS, "https://github.com/mattpocock/skills.git"),
)
MANAGED_SKILLS = {
    "frontend-studio": FRONTEND_STUDIO,
    "grilling": MATTPOCOCK_SKILLS / "skills" / "productivity" / "grilling",
}
SKILL_DEPENDENCIES = (("frontend-studio", "grilling"),)
MARK = "generated by tstack setup"
# Terminals easld spawns from a system unit lack the user bus that systemctl --user needs.
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
BUS = {**os.environ, "XDG_RUNTIME_DIR": RUNTIME,
       "DBUS_SESSION_BUS_ADDRESS": os.environ.get("DBUS_SESSION_BUS_ADDRESS") or f"unix:path={RUNTIME}/bus"}


class Fail(Exception):
    pass



def machine() -> str:
    """$TSTACK_MACHINE, else the instance machine dir matching this host's short name, else that name."""
    host = socket.gethostname().split(".")[0]
    machines = INSTANCE / "machines"
    names = sorted(p.name for p in machines.iterdir() if p.is_dir()) if machines.is_dir() else []
    return os.environ.get("TSTACK_MACHINE") or next((n for n in names if host == n or host.endswith("-" + n)), host)


def owned(path: Path) -> bool:
    real = Path(os.path.realpath(path))
    roots = [Path(os.path.realpath(root)) for root in (ENGINE, INSTANCE, *MANAGED_SKILLS.values())]
    return path.is_symlink() and any(real == root or root in real.parents for root in roots)


def sources(folders, pick) -> dict:
    """Name to path for every entry `pick` accepts in the folders that exist; a later folder wins a name."""
    found = {}
    for folder in folders:
        if folder.is_dir():
            found.update({p.name: p for p in sorted(folder.iterdir()) if not p.name.startswith(".") and pick(p)})
    return found


def link_dir(target: Path, wanted: dict, out: list) -> None:
    target.mkdir(parents=True, exist_ok=True)
    for entry in sorted(target.iterdir()):
        if entry.name not in wanted and owned(entry):
            entry.unlink()
            out.append(f"removed {entry}")
    for name, source in sorted(wanted.items()):
        path = target / name
        if path.is_symlink() and os.readlink(path) == str(source):
            continue
        if owned(path):
            path.unlink()
        elif path.exists() or path.is_symlink():
            out.append(f"left {path}: not a tstack link (wanted -> {source})")
            continue
        path.symlink_to(source)
        out.append(f"linked {path} -> {source}")


def write_owned(path: Path, text: str, out: list) -> None:
    """Write a file setup generates. Anything else at `path`, a link included, is reported and left alone."""
    current = None if path.is_symlink() or not path.is_file() else path.read_text(errors="replace")
    if path.is_symlink() or (path.exists() and MARK not in (current or "")[:500]):
        out.append(f"left {path}: not written by tstack setup")
    elif current != text:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text)
        out.append(f"wrote {path}")


def setup(name: str) -> int:
    out, failed = [], False
    box = INSTANCE / "machines" / name
    for path in (ENGINE / "pstack" / "skills", ENGINE / "pstack" / "agents", INSTANCE, box):
        if not path.is_dir():
            out.append(f"skip {path}: missing")
    for label, repo, url in MANAGED_REPOS:
        if not (repo / ".git").exists():
            repo.parent.mkdir(parents=True, exist_ok=True)
            clone = subprocess.run(["git", "clone", "--quiet", url, str(repo)], capture_output=True, text=True)
            if clone.returncode:
                failed = True
                out.append(f"{label}: clone failed: {(clone.stderr or clone.stdout).strip()}")
    skills = {}
    for skill, source in MANAGED_SKILLS.items():
        if (source / "SKILL.md").is_file():
            skills[skill] = source
        else:
            failed = True
            out.append(f"{skill}: missing {source / 'SKILL.md'}")
    for consumer, dependency in SKILL_DEPENDENCIES:
        sibling = MANAGED_SKILLS[consumer].parent / dependency
        source = MANAGED_SKILLS[dependency]
        if sibling.is_symlink() and os.readlink(sibling) == str(source):
            continue
        if sibling.exists() or sibling.is_symlink():
            out.append(f"left {sibling}: not a tstack link (wanted -> {source})")
        else:
            sibling.parent.mkdir(parents=True, exist_ok=True)
            sibling.symlink_to(source)
            out.append(f"linked {sibling} -> {source}")
    skills.update(sources([ENGINE / "pstack" / "skills", INSTANCE / "skills", box / "skills"], Path.is_dir))
    link_dir(OMP / "skills", skills, out)
    for consumer, dependency in SKILL_DEPENDENCIES:
        for reference in (MANAGED_SKILLS[consumer].parent / dependency / "SKILL.md",
                          OMP / "skills" / dependency / "SKILL.md"):
            if not reference.is_file():
                failed = True
                out.append(f"{consumer}: unresolved dependency {reference}")
    link_dir(OMP / "agents", sources([ENGINE / "agents", ENGINE / "pstack" / "agents", INSTANCE / "agents", box / "agents"],
                                     lambda p: p.suffix == ".md"), out)
    link_dir(HOME / ".local" / "bin", sources([ENGINE / "bin", INSTANCE / "bin", box / "bin"],
                                              lambda p: p.is_file() and os.access(p, os.X_OK)), out)
    seats = [INSTANCE / "assistant", *sorted((INSTANCE / "projects").glob("*"))]
    for seat in seats:
        if (seat / "state").is_dir():
            link_dir(seat / ".omp" / "extensions", {"seat-waits.js": ENGINE / "extensions" / "seat-waits.js"}, out)
    if sys.platform == "darwin":
        out.append("skip systemd update units on macOS; coordinators run tstack update on heartbeat")
    else:
        units, unit_dir = ENGINE / "systemd", HOME / ".config" / "systemd" / "user"
        before = len(out)
        for template in sorted(units.iterdir()) if units.is_dir() else []:
            text = template.read_text()
            for key, value in (("@ENGINE@", ENGINE), ("@INSTANCE@", INSTANCE), ("@MACHINE@", name)):
                text = text.replace(key, str(value))
            write_owned(unit_dir / template.name, text, out)
        if any(line.startswith("wrote ") for line in out[before:]):
            if not (Path(RUNTIME) / "bus").exists():
                out.append(f"skip systemctl --user daemon-reload: no user bus at {RUNTIME}/bus")
            else:
                reload = subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True, text=True, env=BUS)
                if reload.returncode:
                    failed = True
                    out.append(f"failed systemctl --user daemon-reload: {(reload.stderr or reload.stdout).strip()}")

    parts = [p for p in (ENGINE / "global.md", INSTANCE / "global.md", box / "global.md") if p.is_file()]
    header = f"<!-- {MARK} from {', '.join(map(str, parts))}. Edit those, then rerun `tstack setup`. -->\n"
    write_owned(OMP / "AGENTS.md", header + "".join(f"\n{p.read_text().strip()}\n" for p in parts), out)

    print("\n".join(out) or f"tstack setup: {name} is current")
    return 1 if failed else 0


def update(name: str) -> int:
    code = 0
    for label, repo in (("engine", ENGINE), ("instance", INSTANCE),
                        *((label, repo) for label, repo, _ in MANAGED_REPOS)):
        if not (repo / ".git").exists():
            print(f"{label}: no checkout at {repo}")
            continue
        head = ["git", "-C", str(repo), "rev-parse", "--short", "HEAD"]
        old = subprocess.run(head, capture_output=True, text=True).stdout.strip()
        if label == "instance":
            with tempfile.TemporaryDirectory(prefix="tstack-update-") as private:
                ref = f"refs/tstack/update/{Path(private).name}"
                try:
                    commit_sync(repo, commit_fetch(repo, ref))
                except subprocess.CalledProcessError as error:
                    code = 1
                    print(f"instance: refresh failed: {one_line(os.fsdecode(error.stderr or error.stdout or b''))}")
                finally:
                    commit_git(repo, "update-ref", "-d", ref)
            new = subprocess.run(head, capture_output=True, text=True).stdout.strip()
            print(f"{label}: {old}..{new}" if new != old else f"{label}: at {old}")
            continue
        pull = subprocess.run(["git", "-C", str(repo), "pull", "--ff-only", "--quiet"], capture_output=True, text=True)
        if pull.returncode:
            code = 1
            print(f"{label}: pull failed at {old}: {(pull.stderr or pull.stdout).strip()}")
            continue
        new = subprocess.run(head, capture_output=True, text=True).stdout.strip()
        print(f"{label}: {old}..{new}" if new != old else f"{label}: at {old}")
    sys.stdout.flush()
    # Setup from the checkout as pulled, not the code this process loaded.
    setup_run = subprocess.run([sys.executable, str(ENGINE / "bin" / "tstack"), "setup", "--machine", name,
                                "--instance", str(INSTANCE)])
    return setup_run.returncode or code


@dataclass(frozen=True)
class Change:
    path: str
    old_mode: str
    new_mode: str
    old_sha: str
    new_sha: str


def commit_git(root: Path, *args: str, env=None, stdin: bytes | None = None, check=True):
    result = subprocess.run(["git", "-C", str(root), *args], input=stdin, capture_output=True,
                            env={**os.environ, **env} if env is not None else None)
    if check:
        result.check_returncode()
    if not result.returncode and result.stderr:
        sys.stderr.buffer.write(result.stderr)
        sys.stderr.buffer.flush()
    return result


def commit_rev(root: Path, *args: str) -> str:
    return os.fsdecode(commit_git(root, *args).stdout).rstrip("\n")


def commit_fetch(root: Path, ref: str) -> str:
    commit_git(root, "fetch", "-q", "--no-tags", "--no-write-fetch-head", "--refmap=", "origin",
               f"+refs/heads/main:{ref}")
    return commit_rev(root, "rev-parse", "--verify", f"{ref}^{{commit}}")


def commit_ancestor(root: Path, old: str, new: str) -> bool:
    result = commit_git(root, "merge-base", "--is-ancestor", old, new, check=False)
    if result.returncode not in (0, 1):
        result.check_returncode()
    return result.returncode == 0


def commit_changes(root: Path, old: str, new: str) -> list[Change]:
    records = commit_git(root, "diff-tree", "-r", "-z", "--no-renames", "--no-abbrev",
                         "--no-commit-id", old, new).stdout.split(b"\0")
    changes = []
    for header, path in zip(records[::2], records[1::2]):
        old_mode, new_mode, old_sha, new_sha, _ = header.split()
        changes.append(Change(os.fsdecode(path), old_mode[1:].decode(), new_mode.decode(),
                              old_sha.decode(), new_sha.decode()))
    return changes


def commit_push_moved(result, sha: str) -> bool:
    for line in result.stdout.splitlines():
        fields = line.split(b"\t", 2)
        if len(fields) != 3 or fields[:2] != [b"!", f"{sha}:refs/heads/main".encode()]:
            continue
        summary = fields[2]
        if summary in (b"[rejected] (fetch first)", b"[rejected] (non-fast-forward)"):
            return True
        if summary.startswith(b"[remote rejected]"):
            return (summary == b"[remote rejected] (failed to update ref)"
                    or re.search(rb"cannot lock ref[^\n]*expected", summary + result.stderr) is not None)
    return False


def commit_sync_path(root: Path, change: Change, old: str, target: str, env: dict) -> str:
    if "160000" in (change.old_mode, change.new_mode):
        return "unsupported gitlink"
    path = root / change.path
    for parent in reversed(path.parents):
        if parent == root or root not in parent.parents:
            continue
        if parent.is_symlink():
            return "symlink parent"
        if parent.exists() and not parent.is_dir():
            return "non-directory parent"
    if change.old_mode == "000000" and (path.exists() or path.is_symlink()):
        return "local edit"
    result = commit_git(root, "diff", "--quiet", old, "--",
                        f":(top,literal){change.path}", f":(top,exclude,literal){change.path}/",
                        env=env, check=False)
    if result.returncode == 1:
        return "local edit"
    result.check_returncode()
    commit_git(root, "checkout", "--no-overlay", target, "--",
               f":(top,literal){change.path}", f":(top,exclude,literal){change.path}/", env=env)
    return ""


def commit_sync(root: Path, target: str) -> None:
    common = Path(commit_rev(root, "rev-parse", "--git-common-dir"))
    if not common.is_absolute():
        common = root / common
    fd = os.open(common / "tstack-sync.flock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        refs = commit_rev(root, "for-each-ref", "--format=%(refname) %(objectname)", "refs/heads/main")
        old = next((line.split()[1] for line in refs.splitlines() if line.startswith("refs/heads/main ")), None)
        if old is None:
            print("skipped main: no local main", flush=True)
            return
        if old == target:
            return
        if not commit_ancestor(root, old, target):
            reason = "local commits beyond origin tip" if commit_ancestor(root, target, old) else "unpushed local commits"
            print(f"skipped main: {reason}", flush=True)
            return
        head = commit_git(root, "symbolic-ref", "-q", "HEAD", check=False)
        if head.returncode not in (0, 1):
            head.check_returncode()
        if head.stdout.rstrip(b"\n") == b"refs/heads/main":
            changes = sorted(commit_changes(root, old, target), key=lambda c: (c.new_mode != "000000", c.path))
            staged_paths = set()
            for change in changes:
                staged = commit_git(root, "--literal-pathspecs", "diff", "--cached", "--quiet", old,
                                    "--", change.path, check=False)
                if staged.returncode not in (0, 1):
                    staged.check_returncode()
                if staged.returncode:
                    staged_paths.add(change.path)
            entries = []
            synced = []
            indexed = []
            with tempfile.TemporaryDirectory(prefix="tstack-sync-") as private:
                env = {"GIT_INDEX_FILE": str(Path(private) / "index")}
                commit_git(root, "read-tree", old, env=env)
                try:
                    for change in changes:
                        if change.path in staged_paths:
                            print(f"skipped {change.path}: staged edit", flush=True)
                            continue
                        if "state" in change.path.split("/"):
                            print(f"checkout: left {change.path}: state file, never rewritten", flush=True)
                        else:
                            reason = commit_sync_path(root, change, old, target, env)
                            if not reason:
                                synced.append(change)
                            print(f"skipped {change.path}: {reason}" if reason else f"synced {change.path}", flush=True)
                        indexed.append(change)
                        entries.append(f"{change.new_mode} {change.new_sha}\t".encode() + os.fsencode(change.path) + b"\0")
                    if entries:
                        commit_git(root, "update-index", "-z", "--index-info", stdin=b"".join(entries))
                    commit_git(root, "update-ref", "-m", "tstack commit: fast-forward", "refs/heads/main", target, old)
                except Exception:
                    for change in reversed(synced):
                        reverse = Change(change.path, change.new_mode, change.old_mode, change.new_sha, change.old_sha)
                        try:
                            reason = commit_sync_path(root, reverse, target, old, env)
                            print(f"rollback skipped {change.path}: {reason}" if reason else f"restored {change.path}",
                                  flush=True)
                        except (OSError, subprocess.CalledProcessError) as error:
                            detail = os.fsdecode(error.stderr or b"") if isinstance(error, subprocess.CalledProcessError) else str(error)
                            print(f"rollback {change.path}: {detail.strip()}", file=sys.stderr, flush=True)
                    try:
                        restore = []
                        for change in reversed(indexed):
                            result = commit_git(root, "diff", "--cached", "--quiet", target, "--",
                                                f":(top,literal){change.path}", f":(top,exclude,literal){change.path}/",
                                                check=False)
                            if result.returncode == 0:
                                restore.append(f"{change.old_mode} {change.old_sha}\t".encode()
                                               + os.fsencode(change.path) + b"\0")
                            elif result.returncode != 1:
                                result.check_returncode()
                        if restore:
                            commit_git(root, "update-index", "-z", "--index-info", stdin=b"".join(restore))
                    except (OSError, subprocess.CalledProcessError) as error:
                        detail = os.fsdecode(error.stderr or b"") if isinstance(error, subprocess.CalledProcessError) else str(error)
                        print(f"rollback index: {detail.strip()}", file=sys.stderr, flush=True)
                    raise
        else:
            print("skipped checkout: HEAD is not main", flush=True)
            commit_git(root, "update-ref", "-m", "tstack commit: fast-forward", "refs/heads/main", target, old)
        print(f"main {old}..{target}", flush=True)


def commit(message: str, paths: list[str]) -> int:
    root = Path(commit_rev(Path.cwd(), "rev-parse", "--show-toplevel"))
    prefix = commit_rev(Path.cwd(), "rev-parse", "--show-prefix")
    specs = [prefix + "state", *paths]
    max_size = 1048576
    with tempfile.TemporaryDirectory(prefix="tstack-commit-") as private:
        ref = f"refs/tstack/commit/{Path(private).name}"
        env = {"GIT_INDEX_FILE": str(Path(private) / "index")}
        try:
            base = commit_fetch(root, ref)
            for attempt in range(1, 4):
                commit_git(root, "read-tree", base, env=env)
                commit_git(root, "--literal-pathspecs", "add", "-A", "--", *specs, env=env)
                tree = commit_rev(root, "rev-parse", f"{base}^{{tree}}")
                built = commit_git(root, "write-tree", env=env).stdout.decode().strip()
                files = [change for change in commit_changes(root, base, built)
                         if change.new_mode in ("100644", "100755", "120000")]
                if files:
                    sizes = commit_git(root, "cat-file", "--batch-check=%(objectsize)",
                                       stdin="".join(f"{change.new_sha}\n" for change in files).encode())
                    restore = []
                    for change, size in zip(files, map(int, sizes.stdout.splitlines())):
                        if size > max_size:
                            print(f"skipped >1MB: {change.path} ({size} bytes)", flush=True)
                            restore.append(f"{change.old_mode} {change.old_sha}\t".encode()
                                           + os.fsencode(change.path) + b"\0")
                    if restore:
                        commit_git(root, "update-index", "-z", "--index-info", stdin=b"".join(restore), env=env)
                        built = commit_git(root, "write-tree", env=env).stdout.decode().strip()
                if built == tree:
                    commit_sync(root, base)
                    print("tstack commit: nothing to commit", flush=True)
                    return 0
                sha = commit_rev(root, "commit-tree", built, "-p", base, "-m", message)
                pushed = commit_git(root, "push", "--porcelain", "origin", f"{sha}:refs/heads/main", check=False)
                target = sha
                if pushed.returncode:
                    if not commit_push_moved(pushed, sha):
                        pushed.check_returncode()
                    tip = commit_fetch(root, ref)
                    if tip == base:
                        pushed.check_returncode()
                    if not commit_ancestor(root, sha, tip):
                        if attempt == 3:
                            pushed.check_returncode()
                        base = tip
                        print(f"retry {attempt + 1}/3: origin/main moved", flush=True)
                        continue
                    target = tip
                for change in commit_changes(root, base, sha):
                    print(f"committed {change.path}", flush=True)
                print(f"pushed {sha}", flush=True)
                commit_sync(root, target)
                print(f"tstack commit: pushed {sha}", flush=True)
                return 0
        finally:
            cleanup = commit_git(root, "update-ref", "-d", ref, check=False)
            if cleanup.returncode:
                if sys.exc_info()[0] is None:
                    cleanup.check_returncode()
                sys.stdout.buffer.write(cleanup.stdout)
                sys.stdout.buffer.flush()
                sys.stderr.buffer.write(cleanup.stderr)
                sys.stderr.buffer.flush()


def one_line(error) -> str:
    return " ".join(str(error).split())[:300] or type(error).__name__


def easl(method: str, **params) -> dict:
    result = subprocess.run(["easl", method, "--json", "@-"], input=json.dumps(params),
                            capture_output=True, text=True)
    if result.returncode:
        raise Fail(f"easl {method}: {one_line(result.stderr or result.stdout)}")
    try:
        return json.loads(result.stdout or "{}")
    except ValueError:
        raise Fail(f"easl {method}: not JSON: {one_line(result.stdout)}")


READ_ERRORS = (OSError, ValueError, KeyError, TypeError, AttributeError)
TASK_COLUMNS = ["id", "effort", "title", "state", "lane", "pr", "updated"]
GAP, BATCH, PANEL_W = 24, 50, 640


@dataclass
class Seat:
    name: str
    path: str
    board: dict | None = None
    health: str = "unread"
    status: dict | None = None
    status_file: str = "missing"
    tasks: list | None = None
    lanes: list | None = None
    todo: list | None = None
    errors: list = field(default_factory=list)


@dataclass
class Snapshot:
    machine: str
    seats: list


def read_pointer(path: Path):
    pointer = path / "state" / "board.json"
    if not pointer.is_file():
        return None
    data = json.loads(pointer.read_text())
    if not isinstance(data, dict) or not data.get("board"):
        raise ValueError("no board id")
    return data


def attempt(seat: Seat, source: str, read):
    try:
        return read()
    except READ_ERRORS as error:
        seat.errors.append({"source": source, "error": one_line(error)})
        return None


def read_tasks(path: Path) -> list:
    lines = path.read_text().splitlines() if path.is_file() else []
    if not lines:
        return []
    if lines[0].split("\t") != TASK_COLUMNS:
        raise ValueError(f"line 1: the header is not {' '.join(TASK_COLUMNS)} (tab-separated)")
    tasks = []
    for number, text in enumerate(lines[1:], 2):
        if not text.strip():
            continue
        cells = text.split("\t")
        if len(cells) != len(TASK_COLUMNS):
            raise ValueError(f"line {number}: {len(cells)} columns, want {len(TASK_COLUMNS)}")
        tasks.append(dict(zip(TASK_COLUMNS, [None if c in ("", "-") else c for c in cells])))
    return tasks


def read_todo(path: Path) -> list:
    if not path.is_file():
        return []
    data = json.loads(path.read_text())
    if not isinstance(data, dict) or not isinstance(data.get("items"), list):
        raise ValueError("expected a JSON object with items[]")
    items = []
    for number, item in enumerate(data["items"], 1):
        if not isinstance(item, dict) or not isinstance(item.get("title"), str):
            raise ValueError(f"item {number}: expected an object with a title string")
        if not isinstance(item.get("done", False), bool):
            raise ValueError(f"item {number}: done must be boolean")
        steps = item.get("steps", [])
        if not isinstance(steps, list) or any(not isinstance(step, str) for step in steps):
            raise ValueError(f"item {number}: steps must be an array of strings")
        items.append({**item, "steps": steps, "done": item.get("done", False)})
    return items


def read_status(path: Path) -> dict:
    data = json.loads(path.read_text())
    if not isinstance(data, dict):
        raise ValueError("not a JSON object")
    steps = data.get("next_steps") or []
    return {**{key: str(data.get(key) or "") for key in ("project", "status", "status_line")},
            "next_steps": [str(step) for step in (steps if isinstance(steps, list) else [steps])[:3]]}


def read_lane(folder: Path, tasks: list) -> dict:
    data = json.loads((folder / "lane.json").read_text())
    task = next((f"{t['id']}: {t['title']}" for t in tasks if t["lane"] == folder.name), None)
    return {"id": folder.name, "task": str(task or data.get("task") or folder.name),
            "status": str(data.get("status") or "unknown"), "pr": str(data.get("pr") or "")}


def read_seat(path: Path) -> Seat:
    state = path / "state"
    seat = Seat(str(path.relative_to(INSTANCE.resolve())), str(path))
    seat.board = attempt(seat, "board.json", lambda: read_pointer(path))
    seat.tasks = attempt(seat, "tasks.tsv", lambda: read_tasks(state / "tasks.tsv"))
    seat.todo = attempt(seat, "todo.json", lambda: read_todo(state / "todo.json"))
    records = attempt(seat, "lanes", lambda: sorted(
        d for d in (state / "lanes").iterdir() if (d / "lane.json").exists() or (d / "lane.json").is_symlink())
        if (state / "lanes").is_dir() else [])
    seat.lanes = None if records is None else []
    for folder in records or []:
        lane = attempt(seat, f"lanes/{folder.name}/lane.json", lambda: read_lane(folder, seat.tasks or []))
        if lane:
            seat.lanes.append(lane)
    status = state / "status.json"
    if status.is_file():
        seat.status = attempt(seat, "status.json", lambda: read_status(status))
        seat.status_file = "ok" if seat.status else "unreadable"
    else:
        seat.errors.append({"source": "status.json", "error": f"missing: write {status}"})
    return seat


def collect() -> Snapshot:
    root = INSTANCE.resolve()
    paths = [root / "assistant", *sorted(p.parent for p in (root / "projects").glob("**/state")
                                       if p.is_dir() and "state" not in p.parent.relative_to(root / "projects").parts)]
    seats = [read_seat(path) for path in paths if (path / "state").is_dir()]
    try:
        agents = easl("agent.list").get("agents") or []
    except Fail as error:
        for seat in seats:
            seat.errors.append({"source": "easl agent.list", "error": one_line(error)})
    else:
        for seat in seats:
            tile = (seat.board or {}).get("tile")
            agent = next((a for a in agents if a.get("tile") == tile), None) if tile else None
            if not tile:
                seat.health = "no tile"
            elif not agent or agent.get("kind") != "omp" or agent.get("live") is False:
                seat.health = "down"
            else:
                seat.health = str((agent.get("lifecycle") or {}).get("state") or "live")
    seats[1:] = sorted(seats[1:], key=lambda s: ((s.status or {}).get("status") != "active", s.name))
    return Snapshot(machine(), seats)


def e(value) -> str:
    return htmlib.escape(str(value or ""))


def project_name(seat: Seat) -> str:
    return (seat.status or {}).get("project") or seat.name.rsplit("/", 1)[-1]


def project_key(seat: Seat) -> str:
    return f"tstack/project/{seat.name}"


def key_of(obj: dict) -> str:
    return obj.get("key") or (obj.get("props") or {}).get("key") or ""


def ownable_question(obj: dict) -> bool:
    key = key_of(obj)
    return obj.get("type") == "question" and (not key or key.startswith(("tstack/", "show/")))


def frame_of(obj: dict) -> dict:
    frame = obj.get("frame") or {}
    return {k: frame.get(k) or 0 for k in ("x", "y", "w", "h")}


def overlaps(a: dict, b: dict) -> bool:
    return a["x"] < b["x"] + b["w"] and b["x"] < a["x"] + a["w"] and a["y"] < b["y"] + b["h"] and b["y"] < a["y"] + a["h"]


@dataclass
class DesiredObject:
    type: str
    props: dict
    frame: dict = field(default_factory=dict)


@dataclass
class ProjectGroup:
    key: str
    title: str
    color: str
    units: list[list[str]] = field(default_factory=list)
    borrowed: set[str] = field(default_factory=set)

    def members(self) -> list[str]:
        return [member for unit in self.units for member in unit]


@dataclass
class BoardDesign:
    desired: dict[str, DesiredObject] = field(default_factory=dict)
    groups: list[ProjectGroup] = field(default_factory=list)
    borrowed: set[str] = field(default_factory=set)
    terminals: set[str] = field(default_factory=set)
    positions: dict[str, dict] = field(default_factory=dict)


def panel_height(text: str, width: int = 64) -> int:
    lines = [sum(2 if unicodedata.east_asian_width(char) in ("W", "F") else 1 for char in line)
             for line in str(text).expandtabs(4).split("\n")]
    return 22 * sum(max(1, math.ceil(length / width)) for length in lines) + 8


def html_panel(title: str, sections: list) -> tuple[str, int]:
    body = f'<h2 style="font-size:20px;line-height:28px;margin:0 0 12px;font-weight:650">{e(title)}</h2>'
    height = 100 + panel_height(title, 44)
    for heading, rows, limit in sections:
        if heading:
            body += f'<h3 style="font-size:14px;line-height:22px;margin:12px 0 4px;font-weight:650">{e(heading)}</h3>'
            height += panel_height(heading) + 16
        content = "".join(f'<div style="padding:4px 0;white-space:pre-wrap">{markup}</div>'
                          for text, markup in rows)
        row_height = sum(panel_height(text) for text, markup in rows)
        style = f"max-height:{limit}px;overflow-y:auto;" if limit and row_height > limit else ""
        body += f'<div style="{style}">{content}</div>'
        height += min(row_height, limit) if limit else row_height
    page = ('<style>html,body{margin:0;padding:0;background:transparent}'
            '*{box-sizing:border-box}a{color:inherit;text-decoration:underline}</style>'
            '<section style="padding:20px;color:#e5e7eb;background:#18202d;'
            'font-family:ui-monospace,monospace;font-size:14px;line-height:22px;'
            f'overflow-wrap:anywhere;word-break:break-word">{body}</section>')
    return page, height


def pr_markup(value: str) -> str:
    if re.fullmatch(r"https://github\.com/[\w.-]+/[\w.-]+/pull/\d+", value):
        return f'<a href="{e(value)}">PR #{e(value.rsplit("/", 1)[-1])}</a>'
    return e(value)


def project_panel(seat: Seat) -> DesiredObject:
    status = seat.status or {}
    lines = [f'{status.get("status") or seat.status_file} | coordinator {seat.health}']
    if status.get("status_line"):
        lines.append(status["status_line"])
    sections = [("", [(line, e(line)) for line in lines], None)]
    if status.get("next_steps"):
        sections.append(("Next steps", [(step, e(step)) for step in status["next_steps"]], None))
    tasks = seat.tasks or []
    task_rows = []
    for task in tasks:
        text = f'{task.get("id") or "?"} [{task.get("state") or "unknown"}] {task.get("title") or ""}'
        if task.get("lane"):
            text += f' | lane {task["lane"]}'
        markup = e(text)
        if task.get("pr"):
            text += f' | {task["pr"]}'
            markup += f' | {pr_markup(task["pr"])}'
        task_rows.append((text, markup))
    sections.append((f"Tasks ({len(tasks)})", task_rows or [("No tasks.", "No tasks.")], 264))
    lanes = [lane for lane in seat.lanes or [] if lane["status"] == "running"]
    rows = []
    for lane in lanes:
        text = f'{lane["id"]} | {lane["status"]}'
        markup = e(text)
        if lane["pr"]:
            text += f' | {lane["pr"]}'
            markup += f' | {pr_markup(lane["pr"])}'
        rows.append((text, markup))
    sections.append((f"Running lanes ({len(lanes)})", rows or [("None.", "None.")], None))
    if seat.errors:
        errors = [f'{error["source"]}: {error["error"]}' for error in seat.errors]
        sections.append(("State errors", [(text, e(text)) for text in errors], None))
    page, height = html_panel(project_name(seat), sections)
    return DesiredObject("html", {"html": page, "title": project_name(seat)},
                         {"w": PANEL_W, "h": height})


def seat_aliases(seats: list[Seat]) -> dict[str, Seat]:
    candidates = {}
    for seat in seats:
        for alias in (seat.name, seat.name.rsplit("/", 1)[-1], seat.path, project_name(seat),
                      (seat.board or {}).get("tile")):
            if alias:
                candidates.setdefault(str(alias).casefold(), []).append(seat)
    return {alias: matches[0] for alias, matches in candidates.items()
            if len({seat.name for seat in matches}) == 1}


def attributed_seat(values: list, aliases: dict) -> Seat | None:
    for value in values:
        if isinstance(value, (dict, list)):
            nested = [value.get(key) for key in ("tile", "name", "project")] if isinstance(value, dict) else value
            match = attributed_seat(nested, aliases)
            if match:
                return match
        if isinstance(value, str) and value.casefold() in aliases:
            return aliases[value.casefold()]
    return None


def question_project(obj: dict, objects: dict, aliases: dict) -> str:
    props = obj.get("props") or {}
    asker = props.get("asker") or {}
    values = ([asker.get("tile"), asker.get("name")] if isinstance(asker, dict) else [asker])
    creator = obj.get("createdBy") or {}
    values += [creator.get("tile"), creator.get("name"), creator.get("agent")]
    for context in props.get("context") or []:
        if not isinstance(context, dict):
            continue
        linked = objects.get(context.get("object"), {})
        values.append(context.get("object"))
        key = key_of(linked)
        if key.startswith("show/"):
            values.append(key.split("/", 2)[1])
        elif key.startswith("tstack/project/"):
            values.append(key.removeprefix("tstack/project/"))
        values.append((linked.get("createdBy") or {}).get("tile"))
        path = context.get("path")
        if isinstance(path, str):
            values.extend(alias for alias, seat in aliases.items()
                          if path == seat.path or path.startswith(seat.path + "/"))
    seat = attributed_seat(values, aliases)
    return project_name(seat) if seat else "Unassigned"


def question_closed_time(obj: dict) -> float | None:
    props = obj.get("props") or {}
    if props.get("status") == "answered":
        value = (props.get("answer") or {}).get("at")
    elif props.get("status") == "cancelled":
        value = next((value for value in (props.get("closedAt"), props.get("cancelledAt"), obj.get("closedAt"),
                                         props.get("updatedAt"), obj.get("updatedAt"))
                      if value is not None and value != ""), None)
    else:
        return None
    try:
        if isinstance(value, (int, float)) and not isinstance(value, bool):
            return float(value) + 978307200 if math.isfinite(value) else None
        if isinstance(value, str):
            parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
            return parsed.replace(tzinfo=timezone.utc).timestamp() if parsed.tzinfo is None else parsed.timestamp()
    except (ValueError, OverflowError, OSError):
        pass
    return None


def design_board(snap: Snapshot, board_id: str, objects: dict) -> BoardDesign:
    design = BoardDesign()
    aliases = seat_aliases(snap.seats)
    you = ProjectGroup("tstack/you", "You", "orange")
    design.groups.append(you)
    todo_rows = []
    for seat in snap.seats:
        for item in seat.todo or []:
            if item["done"]:
                continue
            prefix = item["title"].partition(":")[0].strip()
            owner = attributed_seat([item.get("project"), item.get("with"), prefix,
                                     prefix.replace(".", "-")], aliases) or seat
            text = f'{project_name(owner)} | {item["title"]}'
            if item["steps"]:
                text += "\n" + "\n".join(f'  {number}. {step}' for number, step in enumerate(item["steps"], 1))
            todo_rows.append((text, e(text)))
    todo_errors = [f'{project_name(seat)} | {error["error"]}' for seat in snap.seats
                   for error in seat.errors if error["source"] == "todo.json"]
    sections = [(f"Open items ({len(todo_rows)})", todo_rows or [("No open todo items.", "No open todo items.")], None)]
    if todo_errors:
        sections.append(("Todo state errors", [(text, e(text)) for text in todo_errors], None))
    page, height = html_panel("Needs you", sections)
    design.desired["tstack/todo"] = DesiredObject("html", {"html": page, "title": "Needs you"},
                                                 {"w": PANEL_W, "h": height})
    you.units.append(["tstack/todo"])
    assigned = set()

    def borrow(group: ProjectGroup, obj: dict, label: str | None = None):
        identity = obj["id"]
        if identity in assigned:
            return
        assigned.add(identity)
        group.borrowed.add(identity)
        unit = []
        if label:
            key = "tstack/label/" + ("digest" if label == "digest" else identity)
            text = "Assistant" if label == "digest" else question_project(obj, objects, aliases)
            design.desired[key] = DesiredObject("shape", {"kind": "text", "text": text, "color": "grey",
                                                         "textSize": 0.7},
                                                {"w": min(max(160, len(text) * 9), PANEL_W),
                                                 "h": 24 + 20 * (len(text) // 60)})
            unit.append(key)
        unit.append(identity)
        group.units.append(unit)

    previous_you = next((obj for obj in objects.values() if key_of(obj) == you.key), {})
    previous_members = set((previous_you.get("props") or {}).get("members") or [])
    now = time.time()
    for obj in sorted(objects.values(), key=lambda obj: obj["id"]):
        props = obj.get("props") or {}
        if not ownable_question(obj) or props.get("archived"):
            continue
        status = props.get("status", "open")
        closed_at = question_closed_time(obj)
        retained = (obj["id"] in previous_members and status in ("answered", "cancelled", "expired")
                    and (closed_at is None or now - closed_at < 1800))
        if status == "open" or retained:
            borrow(you, obj, obj["id"])
    digests = [obj for obj in objects.values() if obj.get("type") == "note"
               and key_of(obj) in ("digest", "show/assistant/digest")
               and not (obj.get("props") or {}).get("archived")]
    for obj in sorted(digests, key=lambda obj: (key_of(obj) != "digest", obj["id"])):
        borrow(you, obj, "digest")
        break
    for seat in snap.seats:
        group = ProjectGroup(f"tstack/group/{seat.name}", project_name(seat),
                             "blue" if seat.name == "assistant" else "violet")
        group.units.append([project_key(seat)])
        design.desired[project_key(seat)] = project_panel(seat)
        tile = (seat.board or {}).get("tile")
        terminal = objects.get(tile, {})
        if (seat.board or {}).get("board") == board_id and terminal.get("type") == "terminal":
            borrow(group, terminal)
            design.terminals.add(tile)
        prefix = f'show/{Path(seat.path).name}/'
        for obj in sorted(objects.values(), key=lambda obj: (key_of(obj), obj["id"])):
            if (key_of(obj).startswith(prefix) and not (obj.get("props") or {}).get("archived")
                    and obj.get("type") not in ("group", "arrow", "question")
                    and not (obj.get("type") == "code" and (obj.get("props") or {}).get("followOf"))):
                borrow(group, obj)
        design.groups.append(group)
    design.borrowed = assigned
    for group in design.groups:
        design.desired[group.key] = DesiredObject("group", {"members": group.members(), "title": group.title,
                                                            "color": group.color, "padding": 24})
    return design


def place_groups(design: BoardDesign, objects: dict, obstacles: list[dict]):
    dimensions = {identity: frame_of(objects[identity]) for identity in design.borrowed}
    dimensions.update({key: obj.frame for key, obj in design.desired.items()})
    sizes = []
    for group in design.groups:
        members = group.members()
        width = max(dimensions[member]["w"] for member in members) + 48
        height = sum(dimensions[member]["h"] for member in members) + GAP * (len(members) - 1) + 80
        sizes.append((width, height))

    def measure(columns: int) -> tuple[float, float]:
        rows = [sizes[start:start + columns] for start in range(0, len(sizes), columns)]
        width = max(sum(w for w, h in row) + GAP * (len(row) - 1) for row in rows)
        height = sum(max(h for w, h in row) for row in rows) + GAP * (len(rows) - 1)
        return width, height

    def score(columns: int) -> tuple[float, float, int]:
        width, height = measure(columns)
        return abs(math.log(width / height)), width * height, columns

    columns = min(range(min(2, len(sizes)), len(sizes) + 1), key=score)
    bounds = []
    top = 0
    for start in range(0, len(sizes), columns):
        left = 0
        for width, height in sizes[start:start + columns]:
            bounds.append({"x": left, "y": top, "w": width, "h": height})
            left += width + GAP
        top += max(h for w, h in sizes[start:start + columns]) + GAP

    def hits(origin: float) -> list[tuple[dict, dict]]:
        return [(column, frame) for column in bounds for frame in obstacles
                if overlaps({**column, "x": column["x"] + origin}, frame)]

    todo = next((obj for obj in objects.values() if key_of(obj) == "tstack/todo"), None)
    origin = frame_of(todo)["x"] - 24 if todo else 0
    if hits(origin):
        origin = 0
        while collisions := hits(origin):
            origin = max(frame["x"] + frame["w"] - column["x"] for column, frame in collisions) + GAP

    for group, column in zip(design.groups, bounds):
        offset = column["y"] + 56
        for member in group.members():
            position = {"x": origin + column["x"] + 24, "y": offset}
            if member in design.desired:
                design.desired[member].frame.update(position)
            else:
                design.positions[member] = position
            offset += dimensions[member]["h"] + GAP


def reconcile_board(board_id: str, design: BoardDesign, objects: dict, existing: dict,
                    obsolete: list[dict], caller: dict) -> list[str]:
    ids = {key: obj["id"] for key, obj in existing.items()}
    pending, pending_keys, output = [], {}, []

    def flush():
        if not pending:
            return
        result = easl("object.batch", board=board_id, ops=pending, **caller)
        results = result.get("results") or []
        if len(results) != len(pending):
            raise Fail("easl object.batch: incomplete results")
        for key, index in pending_keys.items():
            identity = (results[index].get("object") or {}).get("id")
            if not identity:
                raise Fail(f"easl object.batch: no id for {key}")
            ids[key] = identity
        pending.clear()
        pending_keys.clear()

    def add(method: str, params: dict, key: str | None = None):
        if len(pending) == BATCH:
            flush()
        if key:
            pending_keys[key] = len(pending)
        pending.append({"method": method, "params": params})

    for obj in obsolete:
        add("object.delete", {"id": obj["id"]})
        output.append(f'{key_of(obj) or obj["id"]}\tdeleted')
    for identity, position in sorted(design.positions.items()):
        obj = objects[identity]
        params = {"id": identity}
        if any(frame_of(obj)[axis] != position[axis] for axis in ("x", "y")):
            params["frame"] = position
        if identity in design.terminals and (obj.get("props") or {}).get("follow") is not False:
            params["props"] = {"follow": False}
        if len(params) > 1:
            add("object.update", params)
    for key, desired in design.desired.items():
        if len(pending) == BATCH:
            flush()
        props = dict(desired.props)
        if desired.type == "group":
            props["members"] = [f"${pending_keys[member]}" if member in pending_keys else ids.get(member, member)
                                for member in props["members"]]
        old = existing.get(key)
        changed = not old or any((old.get("props") or {}).get(name) != value for name, value in props.items())
        moved = desired.type != "group" and (not old or frame_of(old) != desired.frame)
        if changed or moved:
            params = {"key": key, "type": desired.type, "props": props}
            if desired.type != "group":
                params["frame"] = desired.frame
            add("object.upsert", params, key)
        output.append(f"{key}\t{'created' if not old else 'updated' if changed or moved else 'unchanged'}")
    flush()
    check = easl("layout.check", board=board_id, ids=sorted(set(ids.values()) | design.borrowed))
    precision = "approximate" if check.get("approximate") is True else "precision unreported"
    findings = {key: value for key, value in check.items() if value and key not in ("hints", "approximate")}
    return output + [f"layout.check\t{precision}\t" + (json.dumps(findings, sort_keys=True) if findings else "clean")]


def draw(snap: Snapshot, pointer: dict) -> list:
    board_id = pointer["board"]
    caller = {"caller": os.environ["EASL_TILE_ID"]} if os.environ.get("EASL_TILE_ID") else {}
    with ThreadPoolExecutor(max_workers=8) as pool:
        manifest = pool.submit(easl, "board.get", board=board_id)
        owned = pool.submit(easl, "object.find", board=board_id, keyPrefix="tstack/")
        questions = pool.submit(easl, "object.find", board=board_id, type="question")
        legacy = pool.submit(easl, "object.find", board=board_id, keyPrefix="mc/project/")
        objects = {obj["id"]: obj for obj in manifest.result().get("objects") or []}
        found = owned.result().get("objects") or []
        closed = questions.result().get("objects") or []
        old_cards = legacy.result().get("objects") or []
        objects.update({obj["id"]: obj for obj in found + closed + old_cards})
        full = {obj["id"]: pool.submit(easl, "object.get", id=obj["id"])
                for obj in found + old_cards if obj.get("type") == "html"}
        for identity, future in full.items():
            obj = future.result().get("object")
            if not obj:
                raise Fail(f"easl object.get: no object for {identity}")
            objects[identity] = obj
    existing = {key_of(obj): objects[obj["id"]] for obj in found}
    design = design_board(snap, board_id, objects)
    obsolete = {obj["id"]: obj for key, obj in existing.items()
                if key not in design.desired and obj["id"] not in design.borrowed
                and not (obj.get("type") == "question"
                         and (obj.get("props") or {}).get("status") in ("answered", "cancelled", "expired"))}
    for obj in old_cards:
        key = key_of(obj)
        props = objects[obj["id"]].get("props") or {}
        seat_name = key.removeprefix("mc/project/")
        known_name = seat_name == "assistant" or (seat_name.startswith("projects/") and len(seat_name) > 9)
        if (known_name and key == f"mc/project/{seat_name}" and obj.get("type") == "html"
                and 'data-project="' in props.get("html", "")):
            obsolete[obj["id"]] = obj
    now = time.time()
    for obj in closed:
        closed_at = question_closed_time(obj) if ownable_question(obj) else None
        if closed_at is not None and now - closed_at >= 1800 and obj["id"] not in design.borrowed:
            obsolete[obj["id"]] = obj
    for key, desired in design.desired.items():
        old = existing.get(key)
        if old and old.get("type") != desired.type:
            obsolete[old["id"]] = old
            del existing[key]
    existing = {key: obj for key, obj in existing.items() if key in design.desired}
    ignored = design.borrowed | set(obsolete) | {obj["id"] for obj in existing.values()}
    obstacles = [frame_of(obj) for identity, obj in objects.items()
                 if identity not in ignored and obj.get("type") != "arrow"
                 and not (obj.get("props") or {}).get("archived")]
    place_groups(design, objects, obstacles)
    output = reconcile_board(board_id, design, objects, existing,
                             sorted(obsolete.values(), key=lambda obj: obj["id"]), caller)
    return output + [f"group\t{group.key}\tborrowed {len(group.borrowed)}" for group in design.groups]


def board(a) -> int:
    assistant = INSTANCE.resolve() / "assistant"
    cwd = Path(os.environ.get("TSTACK_SEAT") or Path.cwd()).resolve()
    if not a.print_only and cwd != assistant and INSTANCE.resolve() / "projects" in (cwd, *cwd.parents):
        print("board\tthe assistant draws the board")
        return 0
    if not (assistant / "state").is_dir():
        raise Fail(f"no seat at {assistant}: it has no state/ dir")
    snap = collect()
    if a.print_only:
        print(json.dumps(asdict(snap), indent=1, sort_keys=True))
        return 0
    pointer = snap.seats[0].board
    if not pointer:
        raise Fail(f"no board: write {assistant / 'state' / 'board.json'}")
    print("\n".join(draw(snap, pointer)))
    return 0


def main(argv) -> int:
    global INSTANCE
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--instance", help="instance checkout (default $TSTACK_INSTANCE, else ~/agents)")
    common.add_argument("--machine", help="machine name (default $TSTACK_MACHINE, else matched from the hostname)")
    top = argparse.ArgumentParser(prog="tstack", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = top.add_subparsers(dest="cmd", required=True)
    text = ("Clone frontend-studio and mattpocock/skills into ~/worktrees, link frontend-studio and its "
            "grilling dependency, and set up skills, agents, commands and update units.")
    sub.add_parser("setup", parents=[common], help=text, description=text)
    text = ("Pull the engine and managed frontend-studio and mattpocock-skills checkouts with --ff-only, "
            "safely refresh the instance, and rerun setup.")
    sub.add_parser("update", parents=[common], help=text, description=text)
    text = ("Push seat state and additional paths through a private index with a fixed 1 MiB limit. "
            "Refresh unchanged non-state files from main without overwriting local or staged edits.")
    p = sub.add_parser("commit", help=text, description=text)
    p.add_argument("message", help="commit message")
    p.add_argument("--path", action="append", default=[], help="another literal repo-root-relative path to commit")
    text = ("Draw a You group with open questions, todos and digest, plus project groups with full status, "
            "coordinator terminals and show/<project>/* tiles. The assistant owns this layout. "
            "Showcase sizes and unrelated tiles are preserved; --print is read-only.")
    p = sub.add_parser("board", parents=[common], help=text, description=text)
    p.add_argument("--print", dest="print_only", action="store_true", help="print the snapshot without drawing")
    a = top.parse_args(argv)
    if a.cmd == "commit":
        return commit(a.message, a.path)
    if a.instance:
        INSTANCE = Path(a.instance).expanduser().resolve()
    if a.machine:
        os.environ["TSTACK_MACHINE"] = a.machine
    if a.cmd == "setup":
        return setup(machine())
    if a.cmd == "update":
        return update(machine())
    return board(a)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except subprocess.CalledProcessError as error:
        sys.stdout.buffer.write(error.stdout or b"")
        sys.stdout.buffer.flush()
        sys.stderr.buffer.write(error.stderr or b"")
        sys.stderr.buffer.flush()
        sys.exit(error.returncode)
    except Fail as error:
        sys.exit(f"tstack: {error}")
    except FileNotFoundError as error:
        sys.exit(f"tstack: {error.filename}: not found")
