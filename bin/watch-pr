#!/usr/bin/env python3
# watch-pr <github-pr-url> [--until merged|checks|event] [--interval SECS]
#          [--max-interval SECS] [--timeout SECS] [--grace SECS] [--state FILE]
# watch-pr --classify <rollup.json>
# watch-pr --fingerprint <pr.json> [threads-json]
# watch-pr --diff <old.fp.json> <new.fp.json>
# watch-pr --ack FILE
#
# Requires Python 3 and authenticated gh with api --paginate/--slurp support.
# Live stdout: merged <url>, closed <url>, checks-green <url>, checks-red <url>,
# event <url> <keys>, or timeout <url>. Exit 2 reports errors only on stderr.
# Offline stdout: classify prints green/pending/red; fingerprint prints JSON;
# diff prints comma-separated sorted changed keys; ack prints nothing.
# Exit codes: 0 merged/green/event/offline success, 1 closed/red, 2 usage/local
# error or five consecutive failed polls, 3 timeout. A complete poll resets
# failures. Auth, network, malformed responses, and thread-query failures retry
# with the quiet-poll x1.5 backoff, capped by --max-interval. Each gh call has a
# 30-second ceiling within the --timeout deadline, which also bounds sleeping.
# Defaults: --until merged, --interval 60, --max-interval 600, --timeout 0,
# --grace 300. Zero timeout means no overall deadline, not unlimited failures.
# --grace keeps an empty rollup pending for SECS after checks mode starts.
#
# CI classification uses conclusion, then state, then PENDING. Green means
# SUCCESS/NEUTRAL/SKIPPED. Pending means PENDING/EXPECTED/QUEUED/IN_PROGRESS/
# STALE/empty. Any other conclusion is red. Empty rollup is green unless grace
# applies in live checks mode.
#
# Event mode requires --state. A quiet first snapshot establishes the cursor.
# Existing red CI, conflicts, reviews, issue comments, or unresolved threads
# emit event <url> initial,<actionable-keys>. Later changes emit sorted keys.
# Keys: head,state,mergeable,mergeState,ci,failing,reviews,reviewCount,
# reviewEvents,comments,reviewRequests,threads,unresolved. Bot feedback is included.
# Issue comment and review body edits are detected; thread changes use the
# last reply's updatedAt, not earlier comment edits in a thread with replies.
# Events atomically write FILE.pending; FILE advances only via --ack after
# durable handling. Pending events replay before polling; identical pending
# and cursor snapshots use the key "pending". Ack without pending is a no-op.
# Old cursors remain readable. New feedback digests emit a migration event
# once after upgrade. --fingerprint accepts threads-json as [{i,r,u}] or null.
# Accepted URLs are https://github.com/<owner>/<repo>/pull/<positive-integer>
# without query strings or trailing slashes.

import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from tstacklib.prwatch import EVENT_FIELDS, THREADS_QUERY, classify, diff, fingerprint, initial_keys  # noqa: E402


def load(path):
    return json.loads(Path(path).read_text())


def save(path, value):
    temporary = Path(str(path) + f".tmp{os.getpid()}")
    try:
        temporary.write_text(json.dumps(value, separators=(",", ":")) + "\n")
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


class DeadlineExpired(Exception):
    pass


def remaining(deadline):
    if deadline is None:
        return 30
    seconds = deadline - time.monotonic()
    if seconds <= 0:
        raise DeadlineExpired
    return seconds


def gh_json(args, deadline):
    try:
        result = subprocess.run(["gh", *args], capture_output=True, text=True,
                                timeout=min(30, remaining(deadline)), check=True)
    except subprocess.TimeoutExpired:
        remaining(deadline)
        raise ValueError("gh request timed out") from None
    remaining(deadline)
    return json.loads(result.stdout)


def watch(args):
    match = re.fullmatch(r"https://github\.com/([^/]+)/([^/]+)/pull/([1-9][0-9]*)", args.url)
    if not match:
        raise ValueError("need a full https://github.com/<owner>/<repo>/pull/<n> URL")
    if args.until == "event" and not args.state:
        raise ValueError("--until event requires --state FILE")
    state = Path(args.state) if args.state else None
    pending = Path(str(state) + ".pending") if state else None
    if args.until == "event" and pending.exists():
        fp = load(pending)
        if state.exists():
            keys = diff(load(state), fp) or "pending"
        else:
            keys = "initial," + initial_keys(fp)
        print(f"event {args.url} {keys}")
        return 0
    cursor = load(state) if args.until == "event" and state.exists() else None
    if args.until == "event" and state.exists() and not isinstance(cursor, dict):
        raise ValueError("state cursor must be a JSON object")

    start = time.monotonic()
    deadline = start + args.timeout if args.timeout else None
    sleep_for = min(args.interval, args.max_interval)
    failures = 0
    fields = {"merged": "state", "checks": "state,statusCheckRollup", "event": EVENT_FIELDS}[args.until]
    owner, repo, number = match.groups()
    while True:
        try:
            remaining(deadline)
            pr = gh_json(["pr", "view", args.url, "--json", fields], deadline)
            if pr["state"] == "MERGED":
                print(f"merged {args.url}")
                return 0
            if pr["state"] == "CLOSED":
                print(f"closed {args.url}")
                return 1
            if pr["state"] != "OPEN":
                raise ValueError("unknown PR state")
            if args.until == "checks":
                verdict = classify(pr)
                if not pr["statusCheckRollup"] and time.monotonic() - start < args.grace:
                    verdict = "pending"
                if verdict != "pending":
                    print(f"checks-{verdict} {args.url}")
                    return int(verdict == "red")
            elif args.until == "event":
                pages = gh_json(["api", "graphql", "--paginate", "--slurp", "-f", f"query={THREADS_QUERY}",
                                 "-f", f"o={owner}", "-f", f"r={repo}", "-F", f"n={number}"], deadline)
                threads = sorted([
                    {"i": item["id"], "r": item["isResolved"],
                     "u": next(iter(item["comments"]["nodes"]), {}).get("updatedAt", "")}
                    for page in pages
                    for item in page["data"]["repository"]["pullRequest"]["reviewThreads"]["nodes"]
                ], key=lambda item: item["i"])
                fp = fingerprint(pr, threads)
                keys = diff(cursor, fp) if cursor is not None else initial_keys(fp)
                if keys:
                    if cursor is None:
                        keys = "initial," + keys
                    save(pending, fp)
                    print(f"event {args.url} {keys}")
                    return 0
                if cursor is None:
                    save(state, fp)
                    cursor = fp
            failures = 0
        except DeadlineExpired:
            print(f"timeout {args.url}")
            return 3
        except (subprocess.CalledProcessError, subprocess.TimeoutExpired, ValueError, KeyError, TypeError, AttributeError) as error:
            failures += 1
            print(f"watch-pr: poll failed ({failures}/5, {type(error).__name__})", file=sys.stderr)
            if failures == 5:
                return 2
        try:
            delay = sleep_for if deadline is None else min(sleep_for, remaining(deadline))
            time.sleep(delay)
        except DeadlineExpired:
            print(f"timeout {args.url}")
            return 3
        sleep_for = min(args.max_interval, max(sleep_for + 1, sleep_for * 3 // 2))


def nonnegative(value):
    number = int(value)
    if number < 0:
        raise argparse.ArgumentTypeError("seconds must be nonnegative")
    return number


def main(argv):
    if argv and argv[0] in {"--classify", "--fingerprint", "--diff", "--ack"}:
        mode = argv[0]
        expected = 3 if mode == "--diff" else 2
        if len(argv) != expected and not (mode == "--fingerprint" and len(argv) == 3):
            raise ValueError(f"invalid arguments for {mode}")
        if mode == "--classify":
            print(classify(load(argv[1])))
        elif mode == "--fingerprint":
            threads = json.loads(argv[2]) if len(argv) == 3 else None
            print(json.dumps(fingerprint(load(argv[1]), threads), separators=(",", ":")))
        elif mode == "--diff":
            print(diff(load(argv[1]), load(argv[2])))
        elif Path(argv[1] + ".pending").exists():
            Path(argv[1] + ".pending").replace(argv[1])
        return 0
    parser = argparse.ArgumentParser(description="Finite PR watcher owned by the PR-opening session")
    parser.add_argument("url")
    parser.add_argument("--until", choices=["merged", "checks", "event"], default="merged")
    parser.add_argument("--interval", type=nonnegative, default=60)
    parser.add_argument("--max-interval", type=nonnegative, default=600)
    parser.add_argument("--timeout", type=nonnegative, default=0)
    parser.add_argument("--grace", type=nonnegative, default=300)
    parser.add_argument("--state")
    return watch(parser.parse_args(argv))


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, ValueError, KeyError, TypeError, AttributeError) as error:
        print(f"watch-pr: {error}", file=sys.stderr)
        sys.exit(2)
