#!/usr/bin/env python3
"""Print the facts GitHub holds about one pull request. Reads only; never posts, reviews, merges or resolves.

Facts: state, head SHA, mergeability, auto-merge, review decision, each check with its result, each review,
each issue comment (bot notices such as CodeRabbit's "Review limit reached" included) and each unresolved
review thread. After merge also the merge SHA, the workflow runs on it, and their deploy and release jobs.

--until polls every --interval seconds and prints the facts when its condition first holds:
  change    any fact differs from the first poll (the report then starts with the changed keys)
            mergeability compares known values only; the first known value sets its baseline
  merged    the PR is merged or closed
  checks    no check is queued or running (an empty list counts as not started for two minutes)
Every mode also stops when the PR is closed without merging. Exit 0 with facts; 1 when gh fails, with its error.
"""

import argparse
import json
import re
import subprocess
import sys
import time
from collections import Counter
from concurrent.futures import ThreadPoolExecutor

PR_REF = re.compile(r"(?:https://github\.com/)?([\w.-]+)/([\w.-]+)(?:/pull/|#)(\d+)")
PR_FIELDS = ("url,title,state,isDraft,headRefOid,baseRefName,mergeable,mergeStateStatus,reviewDecision,"
             "autoMergeRequest,mergeCommit,mergedAt,reviews,comments,statusCheckRollup")
THREADS_QUERY = """query($o:String!,$r:String!,$n:Int!,$endCursor:String){
  repository(owner:$o,name:$r){pullRequest(number:$n){
    reviewThreads(first:100,after:$endCursor){
      nodes{isResolved,isOutdated,path,line,originalLine,
            comments(first:1){totalCount,nodes{author{login},body,url}}}
      pageInfo{hasNextPage,endCursor}
    }
  }}
}"""
RUNNING = {"QUEUED", "IN_PROGRESS", "WAITING", "REQUESTED", "PENDING", "EXPECTED"}
# A job counts as a deploy or release when its own name is that word, alone or followed by a space. Its own name
# is what follows any "caller / " prefix a reusable workflow adds, so the jobs under a "deploy /" workflow, gates
# such as "check-if-should-deploy" and preparation such as "deploy-slow-check-policy" stay out.
DEPLOY_JOB = re.compile(r"(deploy|release)( |$)", re.I)
EMPTY_CHECKS_GRACE = 120


class GhError(Exception):
    pass


def gh(*args):
    try:
        done = subprocess.run(["gh", *args], capture_output=True, text=True, timeout=120)
    except subprocess.TimeoutExpired:
        raise GhError(f"gh {' '.join(args[:2])} timed out after 120s") from None
    if done.returncode:
        raise GhError(done.stderr.strip() or f"gh {' '.join(args[:2])} exited {done.returncode}")
    return json.loads(done.stdout)


def login(item):
    return (item.get("author") or {}).get("login", "ghost")


def snapshot(repo, number):
    pr = gh("pr", "view", number, "--repo", repo, "--json", PR_FIELDS)
    owner, name = repo.split("/")
    pages = gh("api", "graphql", "--paginate", "--slurp", "-f", f"query={THREADS_QUERY}",
               "-f", f"o={owner}", "-f", f"r={name}", "-F", f"n={number}")
    threads = [t for page in pages for t in page["data"]["repository"]["pullRequest"]["reviewThreads"]["nodes"]]
    return {
        "pr": f"{repo}#{number}", "url": pr["url"], "title": pr["title"], "state": pr["state"], "draft": pr["isDraft"],
        "head": pr["headRefOid"], "base": pr["baseRefName"],
        "mergeable": pr["mergeable"], "merge_state": pr["mergeStateStatus"],
        "auto_merge": (pr["autoMergeRequest"] or {}).get("mergeMethod"),
        "review_decision": pr["reviewDecision"] or None,
        "checks": [{"name": c.get("name") or c.get("context"),
                    "result": c.get("conclusion") or c.get("status") or c.get("state"),
                    "url": c.get("detailsUrl") or c.get("targetUrl") or None} for c in pr["statusCheckRollup"]],
        "reviews": [{"author": login(r), "state": r["state"], "at": r["submittedAt"], "body": r["body"]}
                    for r in pr["reviews"]],
        "comments": [{"author": login(c), "at": c["createdAt"], "body": c["body"], "url": c["url"]}
                     for c in pr["comments"]],
        "threads": [{"path": t["path"], "line": t["line"] or t["originalLine"], "outdated": t["isOutdated"],
                     "comments": t["comments"]["totalCount"], "author": login(first), "body": first["body"],
                     "url": first["url"]}
                    for t in threads if not t["isResolved"] for first in t["comments"]["nodes"][:1]],
        "merge": after_merge(repo, pr) if pr["state"] == "MERGED" else None,
    }


def after_merge(repo, pr):
    sha = pr["mergeCommit"]["oid"]

    def described(run):
        listed = [] if run["conclusion"] == "skipped" else gh(
            "api", f"repos/{repo}/actions/runs/{run['id']}/jobs?per_page=100")["jobs"]
        return {"workflow": run["name"], "event": run["event"], "sha": run["head_sha"],
                "result": run["conclusion"] or run["status"], "url": run["html_url"],
                "jobs": [{"name": j["name"], "result": j["conclusion"] or j["status"], "url": j["html_url"]}
                         for j in listed if DEPLOY_JOB.match(j["name"].rsplit(" / ", 1)[-1])]}

    with ThreadPoolExecutor(8) as pool:
        runs = gh("api", f"repos/{repo}/actions/runs?head_sha={sha}&per_page=100")["workflow_runs"]
        return {"sha": sha, "at": pr["mergedAt"], "runs": list(pool.map(described, runs))}


def stopped(until, first, now, waited):
    if now["state"] == "CLOSED" or (until == "merged" and now["state"] != "OPEN"):
        return True
    if until == "change":
        return now != first
    if until == "checks":
        started = bool(now["checks"]) or waited >= EMPTY_CHECKS_GRACE
        return started and not any(str(c["result"]).upper() in RUNNING for c in now["checks"])
    return False


def headline(body):
    """The first line of a comment that a reader would see: HTML comments, tags, quote and heading marks and
    GitHub alert labels ([!WARNING]) removed."""
    for line in re.sub(r"<!--.*?-->|<[^>]*>", "", body or "", flags=re.S).splitlines():
        line = line.strip(" \t>#")
        if line and not re.fullmatch(r"\[![A-Z]+\]", line):
            return line if len(line) <= 200 else line[:199] + "…"
    return ""


def said(prefix, body):
    text = headline(body)
    return f"{prefix}: {text}" if text else prefix


def grouped(indent, label, items):
    groups = {}
    for item in items:
        groups.setdefault(item["result"] or "none", []).append(item["name"])
    return [f"{indent}{label}{result} ({len(names)}): {', '.join(names)}" for result, names in sorted(groups.items())]


def render(r):
    out = [f"changed: {', '.join(r['changed'])}"] if "changed" in r else []
    out += [f"{r['pr']} {r['state']}{' draft' if r['draft'] else ''}: {r['title']}", r["url"],
            f"head {r['head']} into {r['base']}",
            f"mergeable {r['mergeable']}, merge state {r['merge_state']}, auto-merge {r['auto_merge'] or 'off'}",
            f"review decision {r['review_decision'] or 'none'}",
            f"checks ({len(r['checks'])}):"]
    out += grouped("  ", "", r["checks"])
    out.append(f"reviews ({len(r['reviews'])}):")
    out += [said(f"  {x['author']} {x['state']} {x['at']}", x["body"]) for x in r["reviews"]]
    out.append(f"comments ({len(r['comments'])}):")
    out += [said(f"  {x['author']} {x['at']}", x["body"]) for x in r["comments"]]
    out.append(f"unresolved threads ({len(r['threads'])}):")
    out += [said(f"  {t['path']}:{t['line']}{' outdated' if t['outdated'] else ''} {t['author']} "
                 f"({t['comments']} comments) {t['url']}", t["body"]) for t in r["threads"]]
    m = r["merge"]
    if m:
        out += [f"merged {m['at']} as {m['sha']}",
                f"runs on {m['sha'][:12]} ({len(m['runs'])}):"]
        for x in m["runs"]:
            if x["result"] != "skipped":
                out.append(f"  {x['workflow']} ({x['event']}) on {x['sha'][:12]}: {x['result']} {x['url']}")
                out += grouped("    ", "deploy/release jobs ", x["jobs"])
        skipped = Counter(x["workflow"] for x in m["runs"] if x["result"] == "skipped")
        if skipped:
            out.append("  skipped: " + ", ".join(f"{name} x{count}" for name, count in skipped.items()))
    return "\n".join(out)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("pr", help="https://github.com/<owner>/<repo>/pull/<n> or <owner>/<repo>#<n>")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--once", action="store_true", help="print the facts once (the default)")
    mode.add_argument("--until", choices=["change", "merged", "checks"])
    parser.add_argument("--json", action="store_true", help="print the facts as JSON")
    parser.add_argument("--interval", type=float, default=60, help="seconds between polls (default 60)")
    args = parser.parse_args()
    ref = PR_REF.match(args.pr)
    if not ref:
        parser.error(f"not a pull request: {args.pr}")
    repo, number = f"{ref[1]}/{ref[2]}", ref[3]
    try:
        first = report = snapshot(repo, number)
        compared = report
        start = time.monotonic()
        while args.until and not stopped(args.until, first, compared, time.monotonic() - start):
            time.sleep(args.interval)
            report = snapshot(repo, number)
            compared = report.copy() if args.until == "change" else report
            if args.until == "change":
                for key in ("mergeable", "merge_state"):
                    if report[key] == "UNKNOWN":
                        compared[key] = first[key]
                    elif first[key] == "UNKNOWN":
                        first = {**first, key: report[key]}
    except GhError as error:
        sys.exit(f"watch-pr: {error}")
    if args.until == "change" and report is not first:
        report = {"changed": [key for key in compared if compared[key] != first[key]], **report}
    print(json.dumps(report, indent=2) if args.json else render(report))


if __name__ == "__main__":
    main()
