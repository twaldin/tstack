#!/usr/bin/env python3
"""Check a secret without printing it.

Specs:
  env:<file>:<KEY>                 a KEY in a dotenv file
  envvar:<NAME>                    an environment variable of this process
  file:<path>                      a whole file (trimmed)
  gsm:<project>/<secret>[@<ver>]   a Google Secret Manager version (default: latest)

Commands:
  secret-check info <spec> [--expect-sha256 HEX]
      exists, length, sha256 prefix (8 hex), mtime or createTime/state; MATCH/MISMATCH with --expect-sha256
  secret-check compare <specA> <specB>
      whether the two values are equal (plus both lengths)
  secret-check probe <spec> --url URL [--header 'Authorization: Bearer {}'] [--query NAME]
                     [--method GET] [--timeout 15]
      sends one HTTP request with the value injected and prints only the status code

No value, and no output that could contain one (HTTP bodies, gcloud payloads), is ever printed.
"""

import argparse
import hashlib
import json
import os
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request


class Missing(Exception):
    pass


def _dotenv(path: str, key: str) -> tuple[str, dict]:
    path = os.path.expanduser(path)
    if not os.path.isfile(path):
        raise Missing(f"no file {path}")
    meta = {"mtime": int(os.path.getmtime(path))}
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            s = line.strip()
            if not s or s.startswith("#"):
                continue
            if s.startswith("export "):
                s = s[7:].lstrip()
            name, sep, val = s.partition("=")
            if sep and name.strip() == key:
                val = val.strip()
                if len(val) >= 2 and val[0] == val[-1] and val[0] in "'\"":
                    val = val[1:-1]
                return val, meta
    raise Missing(f"no key {key} in {path}")


def _gsm(spec: str) -> tuple[str, dict]:
    target, _, version = spec.partition("@")
    project, _, secret = target.partition("/")
    if not project or not secret:
        raise ValueError("gsm spec is gsm:<project>/<secret>[@<version>]")
    version = version or "latest"
    base = ["gcloud", "secrets", "versions"]
    where = ["--secret", secret, "--project", project]
    got = subprocess.run(base + ["access", version] + where, capture_output=True, timeout=60)
    if got.returncode != 0:
        # gcloud's stderr names the resource and the auth state, never the payload.
        raise Missing(f"gcloud access failed (exit {got.returncode}): {got.stderr.decode(errors='replace').strip()[-300:]}")
    value = got.stdout.decode("utf-8", errors="replace")
    meta = {}
    desc = subprocess.run(base + ["describe", version] + where + ["--format=json"], capture_output=True, timeout=60)
    if desc.returncode == 0:
        d = json.loads(desc.stdout or b"{}")
        meta = {"version": d.get("name", "").rsplit("/", 1)[-1], "createTime": d.get("createTime"), "state": d.get("state")}
    return value, meta


def resolve(spec: str) -> tuple[str, dict]:
    kind, _, rest = spec.partition(":")
    if kind == "env":
        path, _, key = rest.rpartition(":")
        if not path or not key:
            raise ValueError("env spec is env:<file>:<KEY>")
        return _dotenv(path, key)
    if kind == "envvar":
        if rest not in os.environ:
            raise Missing(f"no env var {rest}")
        return os.environ[rest], {}
    if kind == "file":
        path = os.path.expanduser(rest)
        if not os.path.isfile(path):
            raise Missing(f"no file {path}")
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read().strip(), {"mtime": int(os.path.getmtime(path))}
    if kind == "gsm":
        return _gsm(rest)
    raise ValueError(f"unknown spec kind {kind!r} (env, envvar, file, gsm)")


def sha(v: str) -> str:
    return hashlib.sha256(v.encode()).hexdigest()


def scrub(text: str, *values: str) -> str:
    for v in values:
        if v and len(v) >= 4:
            text = text.replace(v, "[value]")
    return text


def cmd_info(a) -> dict:
    value, meta = resolve(a.spec)
    out = {"spec": a.spec, "exists": True, "length": len(value), "sha256_8": sha(value)[:8], **meta}
    if a.expect_sha256:
        out["expected"] = "MATCH" if sha(value).startswith(a.expect_sha256.lower()) else "MISMATCH"
    return out


def cmd_compare(a) -> dict:
    va, _ = resolve(a.a)
    vb, _ = resolve(a.b)
    return {"a": a.a, "b": a.b, "match": va == vb, "lengthA": len(va), "lengthB": len(vb)}


def cmd_probe(a) -> dict:
    value, _ = resolve(a.spec)
    url = a.url
    if a.query:
        parts = urllib.parse.urlsplit(url)
        q = urllib.parse.parse_qsl(parts.query) + [(a.query, value)]
        url = urllib.parse.urlunsplit(parts._replace(query=urllib.parse.urlencode(q)))
    req = urllib.request.Request(url, method=a.method)
    for h in a.header or []:
        name, _, tmpl = h.partition(":")
        req.add_header(name.strip(), tmpl.strip().replace("{}", value))
    shown = a.url.split("?", 1)[0]
    try:
        with urllib.request.urlopen(req, timeout=a.timeout) as r:
            return {"spec": a.spec, "url": shown, "status": r.status, "valid": 200 <= r.status < 300}
    except urllib.error.HTTPError as e:
        return {"spec": a.spec, "url": shown, "status": e.code, "valid": False}
    except Exception as e:  # network errors carry no secret, but scrub anyway
        return {"spec": a.spec, "url": shown, "error": scrub(f"{type(e).__name__}: {e}", value)}


def main() -> int:
    p = argparse.ArgumentParser(prog="secret-check", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    i = sub.add_parser("info")
    i.add_argument("spec")
    i.add_argument("--expect-sha256")
    c = sub.add_parser("compare")
    c.add_argument("a")
    c.add_argument("b")
    pr = sub.add_parser("probe")
    pr.add_argument("spec")
    pr.add_argument("--url", required=True)
    pr.add_argument("--header", action="append")
    pr.add_argument("--query")
    pr.add_argument("--method", default="GET")
    pr.add_argument("--timeout", type=float, default=15)
    a = p.parse_args()
    try:
        out = {"info": cmd_info, "compare": cmd_compare, "probe": cmd_probe}[a.cmd](a)
    except Missing as e:
        out = {"exists": False, "detail": str(e)}
    except Exception as e:
        out = {"error": f"{type(e).__name__}: {e}"}
    print(json.dumps(out))
    return 0 if "error" not in out and out.get("exists", True) is not False else 1


if __name__ == "__main__":
    sys.exit(main())
