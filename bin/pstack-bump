#!/usr/bin/env bash
# pstack-bump <sha> [upstream-repo]: commit upstream pstack/ unchanged onto pstack-upstream, merge it,
# remove again what pstack/DROPPED lists, report. A conflicted merge stays open: resolve, then git commit.
set -euo pipefail
ref=${1:?usage: pstack-bump <sha> [upstream-repo]}; up=${2:-https://github.com/cursor/plugins.git}
cd "$(git rev-parse --show-toplevel)"; gd=$(git rev-parse --absolute-git-dir); tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
git init -q --bare "$tmp/u"; git -C "$tmp/u" fetch -q --no-tags --depth 1 "$up" "$ref"
sha=$(git -C "$tmp/u" rev-parse FETCH_HEAD); mkdir "$tmp/t"; git -C "$tmp/u" archive FETCH_HEAD pstack | tar -x -C "$tmp/t"
tree=$(cd "$tmp/t" && GIT_INDEX_FILE="$tmp/i" git --git-dir="$gd" --work-tree=. add -A -f pstack && GIT_INDEX_FILE="$tmp/i" git --git-dir="$gd" write-tree)
parent=$(git rev-parse -q --verify refs/heads/pstack-upstream || true)
if [[ -z $parent ]]; then
  parent=$(git rev-parse -q --verify refs/remotes/origin/pstack-upstream || true)
  if [[ -n $parent ]]; then git update-ref refs/heads/pstack-upstream "$parent"; fi
fi
if [[ -z $parent || $(git rev-parse "$parent^{tree}") != "$tree" ]]; then
  git update-ref refs/heads/pstack-upstream "$(git commit-tree "$tree" ${parent:+-p "$parent"} -m "pstack: upstream cursor/plugins $sha")"
fi
git merge -q --no-commit --no-ff --allow-unrelated-histories pstack-upstream || git rev-parse -q --verify MERGE_HEAD >/dev/null
if [[ -f pstack/DROPPED ]]; then git ls-files -- pstack | sort -u | while IFS= read -r p; do
  while read -r g; do if [[ $g && $g != '#'* && $p == pstack/$g ]]; then git rm -q -f -- "$p"; break; fi; done < pstack/DROPPED
done; fi
conflicts=$(git diff --name-only --diff-filter=U)
if [[ -z $conflicts ]] && git rev-parse -q --verify MERGE_HEAD >/dev/null; then git commit -q -m "pstack: merge upstream cursor/plugins $sha"; fi
echo "pstack-upstream is cursor/plugins $sha; our edits:"; git diff --stat --diff-filter=AM pstack-upstream -- pstack/
echo "dropped: $(git diff --name-only --diff-filter=D pstack-upstream -- pstack/ | wc -l | tr -d ' ') files"
[[ -z $conflicts ]] || { printf '%s\n' "$conflicts" | sed 's/^/conflict: /'; echo "resolve them, then git commit"; exit 1; }
