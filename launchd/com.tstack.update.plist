<?xml version="1.0" encoding="UTF-8"?>
<!-- generated by tstack setup from @ENGINE@/launchd. Load once: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.tstack.update.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tstack.update</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>export PATH="$HOME/.local/bin:$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"; mkdir -p "$HOME/.local/state/tstack"; exec "@ENGINE@/bin/tstack" update --instance "@INSTANCE@" --machine "@MACHINE@" &gt;&gt; "$HOME/.local/state/tstack/update.log" 2&gt;&amp;1</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
