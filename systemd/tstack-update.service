# Linked by tstack setup. Enable once: systemctl --user enable --now tstack-update.timer
[Unit]
Description=tstack update: pull the engine and instance, then rerun setup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/tstack/bin/tstack update
